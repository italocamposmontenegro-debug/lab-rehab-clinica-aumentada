---
import Layout from '../../../../layouts/RA01Layout.astro';
import {ra01,demos} from '../../../../config/ra01.config';
export function getStaticPaths(){
 const legacyTargets={casa:'base',rehabilitacion:'apoyo-cognitivo',comunidad:'acceso-motor'} as const;
 return [
 ...demos.map(demo=>({params:{id:demo.id},props:{demo,legacy:false}})),
 ...Object.entries(legacyTargets).map(([id,target])=>({params:{id},props:{demo:demos.find(d=>d.id===target)!,legacy:true}})),
];}
const {demo,legacy}=Astro.props;
const demoUrl=`/ra01/demos/functional.html?view=${demo.id}`;
---
<Layout title={demo.name} path={`${ra01.canonicalPath}/demo/${Astro.params.id}`}>
 <main data-demo-view={demo.id} id="contenido" class="section-shell ra-subpage">
  <p class="ra-eyebrow">Ejemplo demostrativo RA01</p><h1>{demo.name}</h1>
  {legacy&&<p>Esta demostración ahora forma parte de las adaptaciones funcionales RA01. <a href={`${ra01.canonicalPath}/demo/${demo.id}`}>Abrir su dirección actual</a>.</p>}
  <p>{demo.need} Situación ficticia.</p>
  <p>{demo.changes} Prueba los controles y recarga la página para volver al inicio. La voz depende de la disponibilidad de una voz local en tu equipo. Este ejemplo no evalúa a una persona ni recomienda una adaptación clínica.</p>
  <a class="ra-button secondary" href={demoUrl} target="_blank" rel="noopener noreferrer">Abrir demostración en pantalla completa</a>
  <iframe class="ra-demo-frame" title={`Demostración funcional: ${demo.name}`} src={demoUrl} loading="lazy"></iframe>
  <p><a href={`${ra01.canonicalPath}#inscripcion`}>Quiero aprender a construir mi personalización</a></p>
 </main>
</Layout>

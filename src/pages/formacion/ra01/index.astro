---
import RA01Layout from '../../../layouts/RA01Layout.astro';
import Registration from '../../../components/RA01Registration.astro';
import Explorer from '../../../components/RA01Explorer.astro';
import Method from '../../../components/RA01Method.astro';
import Toolkit from '../../../components/RA01Toolkit.astro';
import '../../../styles/ra01-creative.css';
import AnimatedButton from '../../../components/AnimatedButton.astro';
import { ra01, ra01Price, demos, agenda, policyPath } from '../../../config/ra01.config';
const faqs = [
 ['¿Necesito saber programar?', 'No. Comenzarás con una base funcional y una guía de modificaciones. Necesitas manejar archivos, seguir la preparación y revisar críticamente el resultado.'],
 ['¿Qué construiré exactamente?', 'Una versión personalizada de software asistivo de Comunicación Aumentativa y Alternativa: un tablero con mensajes, símbolos, categorías y voz cuando el navegador disponga de una voz compatible.'],
 ['¿Qué necesito preparar?', 'Un computador, conexión estable y las cuentas gratuitas indicadas en la guía. Completa la preparación antes del encuentro y conserva una copia del software original. No necesitas experiencia previa con IA; trabajarás con situaciones ficticias.'],
 ['¿Necesito pagar otras suscripciones?', 'La ruta de RA01 se diseña para completarse sin contratar suscripciones adicionales. Puede requerir cuentas gratuitas en ChatGPT, GitHub y Vercel. Antes de habilitar las ventas se verificará el recorrido completo y sus límites de uso; el computador y la conexión son responsabilidad del participante.'],
 ['¿Qué incluye la inscripción?', 'La sesión intensiva en vivo, el Kit de Construcción RA01, software base, guías y prompts, grabación de apoyo disponible durante 3 meses, certificado según asistencia y acompañamiento posterior durante 3 meses para consultas relacionadas con el método y el proyecto desarrollado en RA01.'],
 ['¿La sesión queda grabada?', 'Sí. Se priorizará la imagen y pantalla del docente, minimizando la exposición de participantes. La grabación se revisará antes de compartirla y estará disponible sólo para personas confirmadas hasta el 31 de enero de 2027. Podrás hacer preguntas por chat si no quieres intervenir con imagen o voz.'],
 ['¿Recibiré un certificado?', 'Sí, un certificado privado de participación emitido por Ítalo Campos Montenegro / Laboratorio de Rehabilitación Clínica Aumentada. Requiere al menos un 80% del tiempo docente efectivo: 200 de 250 minutos. No acredita competencias clínicas, aprobación universitaria ni habilitación profesional. Ver la grabación no sustituye la asistencia en vivo para este certificado.'],
 ['¿Qué pasa si no puedo asistir?', 'La política contempla cancelación voluntaria hasta el 24 de octubre, derechos legales de retracto, cambio de participante hasta el 28 de octubre a las 18:00 y devolución íntegra si cancela el organizador. Consulta el texto completo antes de pagar. La ausencia no acredita asistencia para el certificado.'],
];
---
<RA01Layout>
<main id="contenido" data-ra-landing>
  <section class="section-shell ra-hero">
    <div><p class="ra-eyebrow">{ra01.labName} · RA01</p><h1 class="ra-title">Rehabilitación<br/><span>Aumentada 01</span></h1><p class="ra-descriptor">{ra01.descriptor}</p><p class="ra-intro">Una base funcional. Tus decisiones profesionales. Un proyecto que personalizas y pruebas con acompañamiento.</p><div class="ra-facts"><strong>31 de octubre de 2026</strong><span>09:00–13:30 h · Santiago</span><span>Online en vivo por Zoom</span></div><div class="ra-actions"><AnimatedButton href="#inscripcion">Inscribirme en RA01</AnimatedButton><span><strong>{ra01Price} CLP</strong><br/><span class="ra-small">Kit de Construcción incluido</span></span></div><p class="ra-small" style="margin-top:16px">La construcción requiere computador. <a class="quiet-link" href="#requisitos">Revisa la preparación mínima.</a></p></div>
    <Explorer/>
  </section>
  <aside class="ra-authority"><div class="section-shell"><strong>Ítalo Campos Montenegro</strong><span>Académico e investigador · IA aplicada a salud y educación clínica</span><a href="#quien-guia">Metodología implementada previamente en formación de postgrado →</a></div></aside>
  <section id="demostraciones" class="ra-section"><div class="section-shell"><p class="ra-eyebrow">El resultado de tus decisiones</p><h2>Una arquitectura.<br/>Tres necesidades. Tres resultados.</h2><p class="ra-lead">El profesional interpreta la necesidad; la IA ayuda a implementar los cambios. Estas tres versiones parten de la misma base y conservan voz, filtros y controles de accesibilidad.</p><div class="ra-shared-base"><span>SOFTWARE BASE</span><span>Mensajes + categorías + voz + accesibilidad</span><span>Tres personalizaciones ↓</span></div><div class="ra-three">{demos.map((d,i)=><article class="ra-demo"><div class="ra-demo-label"><span>0{i+1} / Misma arquitectura</span><span>RA01</span></div><img src={d.image.replace('.png','.webp')} srcset={`${d.image.replace('.png','-sm.webp')} 640w, ${d.image.replace('.png','.webp')} 1088w`} sizes="(min-width: 901px) 340px, (min-width: 641px) 29vw, calc(100vw - 48px)" alt={`Vista real de ${d.name}, ejemplo de ${d.context.toLowerCase()}.`} width="1088" height="1313" loading="lazy"/><div class="ra-demo-annotation">{['Mensajes personalizados','Interacción por voz','Organización según contexto'][i]}</div><div class="ra-demo-body"><h3>{d.name}</h3><dl class="ra-context"><div><dt>Usuario</dt><dd>{['Persona que requiere apoyo para comunicar sus preferencias en casa.','Persona que necesita expresar decisiones durante una actividad de rehabilitación.','Integrante de un grupo que requiere apoyo para tomar la palabra.'][i]} <span class="ra-small">Caso ficticio.</span></dd></div><div><dt>Contexto</dt><dd>{d.context}</dd></div><div><dt>Necesidad</dt><dd>{d.need}</dd></div><div><dt>Qué cambió</dt><dd>{d.changes}</dd></div></dl><a href={`${ra01.canonicalPath}/demo/${d.id}`} data-ra-event="ra01_demo_view" data-variant={d.id}>Probar esta versión →</a></div></article>)}</div><p class="ra-small" style="margin-top:20px">Ejemplos demostrativos creados para RA01. No son proyectos históricos de estudiantes ni evidencia de eficacia clínica. Las tarjetas se guardan en ese navegador; para publicar la personalización hay que incorporarla al archivo y probarla en una ventana privada.</p></div></section>
  <section id="personalizacion" class="ra-section ra-personalization" aria-labelledby="ra-personalization-title">
    <div class="section-shell">
      <p class="ra-eyebrow">El criterio detrás de cada versión</p>
      <div class="ra-personalization-intro">
        <h2 id="ra-personalization-title">Personalizar no es sólo cambiar las palabras.</h2>
        <div class="ra-personalization-copy">
          <p>Existen soluciones gratuitas de Comunicación Aumentativa y Alternativa que pueden ser suficientes para muchas personas; algunas también permiten personalizar. RA01 no busca reemplazarlas.</p>
          <p>La experiencia comienza cuando necesitas ir más allá de una configuración estándar: decidir qué mensajes aparecen, cómo se agrupan, dónde se ubican, qué tamaño tienen los elementos, qué colores y contrastes utilizar, cómo organizar la navegación y cómo debe responder la interfaz.</p>
          <p>La accesibilidad requiere considerar la relación entre las características de la persona, la tarea, el contexto y la interfaz. No existe una única configuración óptima para todas las personas.</p>
        </div>
      </div>
      <div class="ra-personalization-system" aria-label="Cuatro dimensiones de la personalización">
        <p class="ra-personalization-system-label">Misma arquitectura funcional <span aria-hidden="true">→</span> decisiones según persona, necesidad y contexto</p>
        <ol class="ra-personalization-dimensions">
          <li><span>01</span><div><h3>Contenido</h3><p>Qué necesita comunicar.</p></div></li>
          <li><span>02</span><div><h3>Organización</h3><p>Cómo se distribuyen categorías, mensajes y elementos.</p></div></li>
          <li><span>03</span><div><h3>Interfaz</h3><p>Tamaño, contraste, color, jerarquía y disposición.</p></div></li>
          <li><span>04</span><div><h3>Interacción</h3><p>Cómo la persona accede y utiliza el sistema.</p></div></li>
        </ol>
      </div>
      <p class="ra-personalization-method">En RA01 aprenderás a utilizar inteligencia artificial para dirigir estas modificaciones desde tu razonamiento profesional, partiendo de una arquitectura funcional y comprobando los cambios en el software.</p>
      <p class="ra-personalization-statement">No personalizas el tablero para que se vea diferente.<br/><strong>Lo personalizas para que funcione mejor para esa persona.</strong></p>
    </div>
  </section>
  <section id="para-quien" class="ra-section soft"><div class="section-shell ra-split"><div><p class="ra-eyebrow">Tu criterio es el punto de partida</p><h2>Para profesionales que quieren construir desde una necesidad.</h2><p class="ra-lead">Fonoaudiología, Terapia Ocupacional, Kinesiología y áreas vinculadas con rehabilitación, discapacidad, inclusión y comunicación. También pueden participar estudiantes avanzados de áreas relacionadas.</p></div><div><ul class="ra-list"><li>Te interesa adaptar tecnología a situaciones clínicas, domiciliarias, comunitarias, educativas o sociales.</li><li>Quieres formular requerimientos concretos y revisar lo que la IA modifica.</li><li>Buscas una experiencia aplicada, con un proyecto y un método para seguir trabajando.</li><li>No necesitas saber programar. Sí disponer de computador y completar la preparación.</li></ul></div></div></section>
  <section class="ra-positioning"><div class="section-shell"><p class="ra-eyebrow">Construcción guiada · criterio profesional</p><h2>NO VIENES A ESCUCHAR SOBRE IA.<br/><em>VIENES A CONSTRUIR CON ELLA.</em></h2><ul><li>Software funcional</li><li>Proyecto personalizado</li><li>Método reutilizable</li></ul></div></section>
  <Method/>
  <div class="ra-mid-cta section-shell"><p>¿Quieres desarrollar tu propia versión?</p><AnimatedButton href="#inscripcion">Inscribirme en RA01</AnimatedButton></div>
  <Toolkit/>
  <section id="quien-guia" class="ra-section soft"><div class="section-shell"><div class="ra-profile"><img src="/italo-profile.jpg" alt="Ítalo Campos Montenegro, docente de RA01." width="400" height="500" loading="lazy"/><div><p class="ra-eyebrow">Quién te acompaña</p><h2>{ra01.instructor}</h2><p style="margin-top:22px">Kinesiólogo, Magíster en Neurorehabilitación, académico e investigador. Desarrolla sistemas y experiencias de aprendizaje que integran inteligencia artificial en salud, rehabilitación y educación clínica, manteniendo el criterio profesional en las decisiones.</p><p>En RA01 guiará la traducción de una necesidad comunicativa a requerimientos, modificaciones controladas y pruebas del software.</p><a class="quiet-link" href="/#trayectoria" data-ra-event="ra01_professional_profile_click">Conocer su trayectoria profesional →</a></div></div><div class="ra-magister"><strong>Una metodología con implementación previa.</strong> El proyecto central se realizó previamente en una actividad del Magíster en Inclusión de Personas con Discapacidad de la Universidad Viña del Mar. RA01 utiliza el mismo proyecto y metodología. Si ya participaste, puedes <a class="quiet-link" href={`${ra01.canonicalPath}/lista-espera`} data-ra-event="ra01_waitlist">conocer futuras experiencias</a> con otro objeto de construcción. Esta actividad es independiente: no se presenta como patrocinada o certificada por UVM.</div></div></section>
  <section id="fecha" class="ra-section"><div class="section-shell ra-split"><div><p class="ra-eyebrow">El encuentro</p><h2>Sábado 31 de octubre.<br/>Una mañana para construir.</h2><p class="ra-lead"><strong>09:00 a 13:30 · America/Santiago</strong><br/>Online en vivo por Zoom. 4 horas y 30 minutos, con dos pausas de 10 minutos.</p><ul class="ra-list"><li>Certificado privado de participación con asistencia mínima del 80% del tiempo docente efectivo.</li><li>Grabación de apoyo disponible durante 3 meses.</li><li>Acompañamiento posterior durante 3 meses para consultas relacionadas con el método y el proyecto desarrollado en RA01.</li></ul><a class="quiet-link" href="/ra01/RA01.ics" download>Agregar al calendario →</a></div><ol class="ra-agenda">{agenda.map(([time,title,text])=><li><time>{time}</time><div><strong>{title}</strong><p>{text}</p></div></li>)}</ol></div></section>
  <section id="requisitos" class="ra-section soft"><div class="section-shell ra-split"><div><p class="ra-eyebrow">Antes de inscribirte</p><h2>Compra desde tu teléfono.<br/>Construye en tu computador.</h2><p class="ra-lead">La ruta se diseña sin compra de suscripciones adicionales. El detalle tecnológico y la guía se entregan con el kit, después de confirmar la inscripción.</p></div><ul class="ra-list"><li>Computador compatible, conexión estable y navegador actualizado.</li><li>Posibilidad de instalar y configurar las herramientas indicadas.</li><li>Disponibilidad para crear cuentas gratuitas en ChatGPT, GitHub y Vercel según la guía.</li><li>Completar la preparación y comunicar bloqueos antes del 28 de octubre.</li><li>Trabajar exclusivamente con situaciones comunicativas ficticias.</li></ul></div></section>
  <section class="ra-section ra-value soft"><div class="section-shell"><p class="ra-eyebrow">Tu inscripción incluye</p><h2>Todo conectado con tu proyecto.</h2><ol>{['Sesión intensiva en vivo','Kit de Construcción RA01','Software base','Guías y sistema de prompts','Grabación de apoyo durante tres meses','Certificado de participación','Acompañamiento posterior durante tres meses'].map((item,i)=><li><span>0{i+1}</span>{item}</li>)}</ol><p class="ra-small">Certificado sujeto a asistencia. Grabación y acompañamiento hasta el 31 de enero de 2027, con el alcance descrito en las condiciones.</p></div></section>
  <section id="inscripcion" class="ra-section"><div class="section-shell ra-split"><div><p class="ra-eyebrow">Inversión y acompañamiento</p><h2>Tu proyecto, el método y una experiencia preparada.</h2><p class="ra-lead">Cupos limitados por formato de construcción acompañada. Trabajaremos con checkpoints y retroalimentación durante el desarrollo.</p><ul class="ra-list"><li>Sesión guiada por Ítalo Campos Montenegro.</li><li>Kit y guía de preparación después de confirmar el pago.</li><li>Grabación de apoyo disponible durante 3 meses.</li><li>Acompañamiento posterior durante 3 meses para consultas relacionadas con el método y el proyecto desarrollado en RA01.</li><li>Certificado de participación según asistencia.</li></ul><p class="ra-small" style="margin-top:22px">Cierre previsto: 26 de octubre a las 18:00, hora de Santiago, o antes al completar la capacidad. Sin descuentos anticipados ni renovación automática.</p><div class="ra-note"><strong>Qué ocurre después</strong><p class="ra-small" style="margin-top:8px">Registras tus datos, pagas y verificamos la operación. Recibes la confirmación y el kit por correo dentro de un día hábil. El enlace de Zoom sólo se entrega a personas confirmadas.</p></div><a class="quiet-link" href={`${ra01.canonicalPath}/ayuda`} data-ra-event="ra01_payment_help">Ya pagué o necesito ayuda →</a></div><Registration/></div></section>
  <section id="preguntas" class="ra-section soft"><div class="section-shell"><p class="ra-eyebrow">Decidir con información</p><h2>Preguntas frecuentes</h2><div class="ra-faq">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div><p class="ra-small" style="margin-top:22px"><a class="quiet-link" href={`${ra01.canonicalPath}/condiciones`}>Condiciones y privacidad</a> · <a class="quiet-link" href={policyPath('soporte')}>Alcance del soporte</a></p></div></section>
  <section class="ra-section ra-end"><div class="section-shell"><p class="ra-eyebrow">RA01 · 31 de octubre de 2026</p><h2>Dirige la tecnología desde<br/>tu conocimiento profesional.</h2><p class="ra-lead">Define la necesidad. Decide qué cambiar. Construye y prueba tu versión.</p><div style="margin-top:28px"><AnimatedButton href="#inscripcion">Inscribirme en RA01</AnimatedButton></div><p class="ra-small" style="max-width:42rem;margin-top:30px">RA01 es la primera experiencia de construcción del Laboratorio de Rehabilitación Clínica Aumentada. Cada nueva edición abordará un proyecto tecnológico diferente.</p></div></section>
</main>
<script>import "../../../scripts/ra01-creative";</script>
</RA01Layout>

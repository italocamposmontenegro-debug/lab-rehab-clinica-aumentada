---
import Layout from '../../../../../layouts/RA01Layout.astro';
import {ra01} from '../../../../../config/ra01.config';
import {policies} from '../../../../../data/ra01-policies';
import {legacyVersion,legacyPolicyTexts} from '../../../../../data/ra01-legacy.mjs';
export function getStaticPaths(){
  const historical=legacyPolicyTexts();
  return [
    ...policies.map(policy=>({params:{version:ra01.termsVersion,slug:policy.slug},props:{policy,legacyText:null}})),
    ...policies.map((policy,index)=>({params:{version:legacyVersion,slug:policy.slug},props:{policy,legacyText:historical[index]}})),
  ];
}
const {policy,legacyText}=Astro.props;
const version=Astro.params.version;
---
<Layout title={policy.title} path={`${ra01.canonicalPath}/legal/${version}/${policy.slug}`}><main id="contenido" class="section-shell ra-subpage ra-policy"><p class="ra-eyebrow">Versión {version}{legacyText?' · Borrador histórico':ra01.release.legalApproved?'':' · Borrador preproducción'}</p><h1>{policy.title}</h1><div class="ra-actions"><a class="ra-button secondary" download href={`${ra01.canonicalPath}/legal/${version}/condiciones.txt`}>Guardar las siete políticas completas</a><button class="ra-button secondary" data-print-policy>Imprimir / guardar PDF</button></div>{legacyText?<div class="ra-policy-legacy">{legacyText}</div>:<>{policy.sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}{policy.sources.length>0&&<section><h2>Fuentes oficiales y documentación</h2><ul>{policy.sources.map(([title,url])=><li><a href={url} rel="noopener noreferrer" target="_blank">{title}</a></li>)}</ul></section>}</>}<p><a href={`${ra01.canonicalPath}/condiciones`}>Todas las condiciones RA01</a></p></main></Layout>
<style>.ra-policy-legacy{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}</style>

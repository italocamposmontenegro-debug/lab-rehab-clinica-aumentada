---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/italo-profile.jpg';
import logo1 from '../assets/logos/logo-1.jpg';
import logo2 from '../assets/logos/logo-2.png';
import logo3 from '../assets/logos/logo-3.jpg';
import logo4 from '../assets/logos/logo-4.jpg';
import logo5 from '../assets/logos/logo-5.jpg';
const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- ============================================================== -->
  <!-- NAVBAR -->
  <!-- ============================================================== -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-neutral-100 transition-all duration-300">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="#inicio" class="font-serif text-lg font-semibold text-neutral-900 tracking-tight hover:text-gold-600 transition-colors">
        Laboratorio RCA
      </a>
      <!-- Mobile menu button -->
      <button id="menu-toggle" class="md:hidden p-2 text-neutral-600 hover:text-gold-600 transition-colors" aria-label="Abrir menú de navegación">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-neutral-600">
        <li><a href="#inicio" class="hover:text-gold-600 transition-colors">Inicio</a></li>
        <li><a href="#soluciones" class="hover:text-gold-600 transition-colors">Soluciones</a></li>
        <li><a href="#laboratorio" class="hover:text-gold-600 transition-colors">Laboratorio</a></li>
        <li><a href="#aplicaciones" class="hover:text-gold-600 transition-colors">Aplicaciones</a></li>
        <li><a href="#investigacion" class="hover:text-gold-600 transition-colors">Investigación</a></li>
        <li><a href="#sobre-mi" class="hover:text-gold-600 transition-colors">Sobre mí</a></li>
        <li><a href="#contacto" class="hover:text-gold-600 transition-colors">Contacto</a></li>
      </ul>
    </div>
    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-100 bg-white">
      <ul class="flex flex-col px-6 py-4 gap-4 text-sm font-medium text-neutral-600">
        <li><a href="#inicio" class="block hover:text-gold-600 transition-colors">Inicio</a></li>
        <li><a href="#soluciones" class="block hover:text-gold-600 transition-colors">Soluciones</a></li>
        <li><a href="#laboratorio" class="block hover:text-gold-600 transition-colors">Laboratorio</a></li>
        <li><a href="#aplicaciones" class="block hover:text-gold-600 transition-colors">Aplicaciones</a></li>
        <li><a href="#investigacion" class="block hover:text-gold-600 transition-colors">Investigación</a></li>
        <li><a href="#sobre-mi" class="block hover:text-gold-600 transition-colors">Sobre mí</a></li>
        <li><a href="#contacto" class="block hover:text-gold-600 transition-colors">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- ============================================================== -->
  <!-- SECTION 1: HOME / HERO -->
  <!-- ============================================================== -->
  <section id="inicio" class="min-h-screen flex flex-col items-center justify-center pt-20 pb-16 px-6">
    <div class="max-w-3xl mx-auto text-center fade-in">
      <!-- Subtle gold line -->
      <div class="w-12 h-px bg-gold-400 mx-auto mb-8"></div>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold text-neutral-900 leading-tight mb-6">
        Soluciones impulsadas por IA para rehabilitación y educación en salud
      </h1>
      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed mb-6 max-w-2xl mx-auto">
        Diseño e implemento tutores virtuales, simuladores clínicos, herramientas digitales y sistemas aplicados para equipos docentes, instituciones y profesionales de la rehabilitación.
      </p>
      
      <!-- Credentials Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-50 border border-neutral-200 rounded-full mb-8">
        <span class="w-2 h-2 rounded-full bg-gold-500"></span>
        <span class="text-xs font-medium text-neutral-600 tracking-wide uppercase">Por Ítalo Campos M. · Mg. Neurorehabilitación e Investigador IA</span>
      </div>

      <p class="text-base font-medium text-neutral-800 leading-relaxed mb-10 max-w-2xl mx-auto text-center border-l-2 border-gold-400 pl-4 py-2 italic bg-gold-50/50">
        Los tutores virtuales desarrollados en este entorno se apoyan en datos obtenidos en estudios sobre tutoría virtual y en experiencia académica aplicada.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#soluciones" class="inline-flex items-center px-8 py-3.5 bg-neutral-900 text-white text-sm font-medium rounded-none hover:bg-gold-700 transition-colors duration-300">
          Ver soluciones
        </a>
        <a href="#contacto" class="inline-flex items-center px-6 py-3.5 border border-neutral-300 text-neutral-700 text-sm font-medium rounded-none hover:border-gold-400 hover:text-gold-700 transition-colors duration-300">
          Solicitar reunión diagnóstica
        </a>
        <a href="#investigacion" class="inline-flex items-center px-6 py-3.5 border border-neutral-300 text-neutral-700 text-sm font-medium rounded-none hover:border-gold-400 hover:text-gold-700 transition-colors duration-300">
          Explorar investigación
        </a>
      </div>
    </div>
    <!-- Trust Bar -->
    <div class="mt-12 md:mt-20 border-t border-neutral-100 pt-8 md:pt-10 w-full max-w-5xl mx-auto fade-in">
      <p class="text-xs text-center text-neutral-500 uppercase tracking-widest mb-6">Trayectoria y Colaboraciones</p>
      <div class="flex flex-wrap justify-center items-center gap-6 md:gap-16 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
        <Image src={logo1} alt="Institución Colaboradora" class="h-8 md:h-12 w-auto object-contain" />
        <Image src={logo2} alt="Institución Colaboradora" class="h-8 md:h-12 w-auto object-contain" />
        <Image src={logo3} alt="Institución Colaboradora" class="h-8 md:h-10 w-auto object-contain" />
        <Image src={logo4} alt="Institución Colaboradora" class="h-8 md:h-12 w-auto object-contain" />
        <Image src={logo5} alt="Institución Colaboradora" class="h-8 md:h-12 w-auto object-contain" />
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 2: SOLUCIONES -->
  <!-- ============================================================== -->
  <section id="soluciones" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8 mx-auto md:mx-0"></div>
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div class="max-w-2xl">
          <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-6">Soluciones para Instituciones y Clínicos</h2>
          <p class="text-base text-neutral-600 leading-relaxed text-justify">
            Diseño arquitecturas de inteligencia artificial que se adaptan a las necesidades del entorno clínico y académico, optimizando la formación, el seguimiento y la intervención.
          </p>
        </div>
        <a href="#contacto" class="hidden md:inline-flex items-center gap-2 px-6 py-3 bg-neutral-900 text-white text-sm font-medium hover:bg-gold-700 transition-colors">
          Solicitar implementación
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- A. Tutores -->
        <div class="bg-neutral-50 p-10 border border-neutral-100 hover:border-gold-300 transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-neutral-900 mb-4">Tutores virtuales académicos</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-6 text-justify">
            Tutores especializados para apoyar aprendizaje clínico, estudio guiado, práctica profesional y acompañamiento docente.
          </p>
          <div class="mb-6 p-4 bg-white border-l-2 border-gold-400">
            <p class="text-xs font-medium text-neutral-600 italic leading-relaxed">
              Su arquitectura se ha nutrido de datos obtenidos en estudios sobre tutores virtuales y de experiencia académica en contextos reales de formación.
            </p>
          </div>
          <a href="#contacto" class="text-sm font-medium text-gold-700 hover:text-gold-900 inline-flex items-center gap-2">
            Ver integración
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <!-- B. Simuladores -->
        <div class="bg-neutral-50 p-10 border border-neutral-100 hover:border-gold-300 transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-neutral-900 mb-4">Simuladores clínicos conversacionales</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-8 text-justify">
            Pacientes simulados y escenarios de interacción clínica para entrenar entrevista, comunicación, razonamiento y evaluación formativa.
          </p>
          <a href="#simulacion" class="text-sm font-medium text-gold-700 hover:text-gold-900 inline-flex items-center gap-2 mt-auto">
            Explorar simuladores
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <!-- C. Seguimiento -->
        <div class="bg-neutral-50 p-10 border border-neutral-100 hover:border-gold-300 transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-neutral-900 mb-4">Sistemas de seguimiento académico</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-8 text-justify">
            Herramientas para apoyar categorización, seguimiento y comprensión de trayectorias estudiantiles en educación superior.
          </p>
          <a href="#aplicaciones" class="text-sm font-medium text-gold-700 hover:text-gold-900 inline-flex items-center gap-2">
            Ver plataforma
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <!-- D. Clínicas -->
        <div class="bg-neutral-50 p-10 border border-neutral-100 hover:border-gold-300 transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-neutral-900 mb-4">Soluciones clínicas personalizadas</h3>
          <p class="text-sm text-neutral-600 leading-relaxed mb-8 text-justify">
            Aplicaciones locales, sistemas de registro, evaluación digital y herramientas adaptadas a necesidades específicas de rehabilitación y formación.
          </p>
          <a href="#aplicaciones" class="text-sm font-medium text-gold-700 hover:text-gold-900 inline-flex items-center gap-2">
            Ver catálogo de apps
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
      
      <div class="mt-8 text-center md:hidden">
        <a href="#contacto" class="inline-flex items-center gap-2 px-6 py-3 bg-neutral-900 text-white text-sm font-medium hover:bg-gold-700 transition-colors w-full justify-center">
          Solicitar implementación
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 3: EL LABORATORIO -->
  <!-- ============================================================== -->
  <section id="laboratorio" class="py-24 px-6 bg-neutral-50">
    <div class="max-w-4xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-8">El Laboratorio</h2>

      <!-- Qué es -->
      <p class="text-base text-neutral-700 leading-relaxed mb-10 text-justify">
        El Laboratorio de Rehabilitación Clínica Aumentada es un sistema educativo continuo donde clínicos desarrollan la capacidad de pensar, construir y evaluar sistemas clínicos aumentados, utilizando inteligencia artificial como soporte para la toma de decisiones clínicas, el análisis de datos y el diseño terapéutico.
      </p>

      <!-- Beneficios (Cards Grid) -->
      <div class="grid md:grid-cols-3 gap-6 mb-20">
        <!-- Benefit 1 -->
        <div class="bg-white p-8 border border-neutral-100 shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="w-12 h-12 bg-neutral-900 flex items-center justify-center mb-6">
            <span class="text-gold-400 text-xl">01</span>
          </div>
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-3">Diferenciación Clínica</h3>
          <p class="text-sm text-neutral-600 leading-relaxed text-justify">
            Domina herramientas que el 99% de tus colegas ignora. Posiciónate como un referente capaz de integrar tecnología avanzada en la práctica diaria.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-white p-8 border border-neutral-100 shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="w-12 h-12 bg-neutral-900 flex items-center justify-center mb-6">
            <span class="text-gold-400 text-xl">02</span>
          </div>
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-3">Eficiencia Real</h3>
          <p class="text-sm text-neutral-600 leading-relaxed text-justify">
            Reduce tiempos de análisis y documentación sin perder calidad humana. Automatiza tareas repetitivas para centrarte en el paciente.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-white p-8 border border-neutral-100 shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="w-12 h-12 bg-neutral-900 flex items-center justify-center mb-6">
            <span class="text-gold-400 text-xl">03</span>
          </div>
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-3">Innovación en Evidencia</h3>
          <p class="text-sm text-neutral-600 leading-relaxed text-justify">
            Integra IA no por moda, sino para resolver problemas clínicos complejos con respaldo científico y validación empírica.
          </p>
        </div>
      </div>

      <!-- Philosophy Section (Qué es / Qué NO es) -->
      <div class="grid md:grid-cols-2 gap-12 items-start mb-20 border-t border-neutral-200 pt-16">
        <div>
          <h3 class="font-serif text-2xl font-semibold text-neutral-900 mb-6">Lo que SÍ es</h3>
          <ul class="space-y-4 text-neutral-600 text-sm leading-relaxed">
            <li class="flex items-start gap-3">
              <span class="text-gold-500 mt-1">✦</span>
              <span>Un espacio de aprendizaje basado en experimentación clínica controlada y rigurosa.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold-500 mt-1">✦</span>
              <span>Un entorno para transformar fenómenos clínicos complejos en sistemas evaluables.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold-500 mt-1">✦</span>
              <span>Un laboratorio donde la IA se integra como extensión del razonamiento clínico.</span>
            </li>
          </ul>
        </div>

        <div>
           <h3 class="font-serif text-2xl font-semibold text-neutral-900 mb-6 text-neutral-400">Lo que NO es</h3>
           <ul class="space-y-4 text-neutral-500 text-sm leading-relaxed">
            <li class="flex items-start gap-3">
              <span class="text-neutral-300 mt-1">—</span>
              <span>No es un curso tradicional pasivo ni teórico.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-neutral-300 mt-1">—</span>
              <span>No es una colección de aplicaciones o prompts genéricos.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-neutral-300 mt-1">—</span>
              <span>No busca automatizar la decisión, sino potenciarla.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Cómo se aprende -->
      <div class="mb-12">
        <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-4">Cómo se aprende</h3>
        <p class="text-sm text-neutral-600 leading-relaxed text-justify">
          El aprendizaje es práctico y progresivo, utilizando casos reales como: análisis del control postural mediante sistemas de COP con hardware accesible; diseño de rehabilitación de extremidad superior apoyada por IA; construcción de sistemas de evaluación clínica de variables complejas, como la sialorrea.
        </p>
      </div>

      <!-- Qué incluye -->
      <div class="mb-12">
        <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-4">Qué incluye</h3>
        <ul class="space-y-2 text-neutral-600 text-sm leading-relaxed">
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Curso base de entrada al Laboratorio.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Acceso continuo al entorno del Laboratorio.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Casos clínicos documentados.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Sistemas clínicos aumentados listos para explorar y adaptar.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Actualizaciones periódicas según avances clínicos y tecnológicos.</li>
        </ul>
      </div>

      <!-- Del laboratorio a la implementación -->
      <div class="mb-16 p-8 bg-gold-50/30 border border-gold-200">
        <h3 class="font-serif text-xl font-semibold text-neutral-900 mb-4">Del laboratorio a la implementación</h3>
        <p class="text-sm text-neutral-700 leading-relaxed mb-6 text-justify">
          Además del entorno formativo, el laboratorio desarrolla y adapta soluciones concretas para docencia, simulación, seguimiento académico y rehabilitación clínica.
        </p>
        <p class="text-sm text-neutral-700 font-medium italic mb-6">
          Parte de esta infraestructura se ha construido utilizando aprendizajes obtenidos en estudios sobre tutores virtuales, integrando evidencia empírica con experiencia académica y diseño aplicado.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#soluciones" class="px-4 py-2 bg-white border border-neutral-200 text-xs font-medium text-neutral-700 hover:border-gold-400 hover:text-gold-700 transition-colors">Tutores virtuales</a>
          <a href="#simulacion" class="px-4 py-2 bg-white border border-neutral-200 text-xs font-medium text-neutral-700 hover:border-gold-400 hover:text-gold-700 transition-colors">Simuladores clínicos</a>
          <a href="#aplicaciones" class="px-4 py-2 bg-white border border-neutral-200 text-xs font-medium text-neutral-700 hover:border-gold-400 hover:text-gold-700 transition-colors">Aplicaciones clínicas</a>
          <a href="#aplicaciones" class="px-4 py-2 bg-white border border-neutral-200 text-xs font-medium text-neutral-700 hover:border-gold-400 hover:text-gold-700 transition-colors">Sistemas de seguimiento</a>
          <a href="#contacto" class="px-4 py-2 bg-white border border-neutral-200 text-xs font-medium text-neutral-700 hover:border-gold-400 hover:text-gold-700 transition-colors">Soluciones personalizadas</a>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a href="https://wa.me/56977402337?text=Hola%20%C3%8Dtalo%2C%20quiero%20informaci%C3%B3n%20sobre%20c%C3%B3mo%20ingresar%20al%20Laboratorio." class="inline-flex items-center gap-2 px-8 py-3.5 bg-neutral-900 text-white text-sm font-medium rounded-none hover:bg-gold-700 transition-colors duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Hablar por WhatsApp
        </a>
      </div>

      <!-- Nota ética -->
      <p class="mt-10 text-xs text-neutral-400 text-center leading-relaxed border-t border-neutral-200 pt-6">
        Uso educativo y formativo. No entrega diagnóstico ni recomendaciones clínicas personalizadas para pacientes. La responsabilidad clínica recae siempre en el profesional tratante.
      </p>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 4: APLICACIONES Y DESARROLLOS -->
  <!-- ============================================================== -->
  <section id="aplicaciones" class="py-24 px-6 bg-white border-t border-neutral-100">
    <div class="max-w-6xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8 mx-auto md:mx-0"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-6">Aplicaciones y desarrollos</h2>
      <p class="text-base text-neutral-600 leading-relaxed mb-16 max-w-3xl text-justify">
        Catálogo de soluciones activas implementadas como parte de las capacidades del laboratorio. Estas aplicaciones integran lógica clínica, visión computacional y modelos de lenguaje, listas para su adopción y adaptación institucional.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- App 1: HandMov -->
        <article class="bg-white border border-neutral-200 overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col">
          <div class="w-full aspect-video bg-neutral-100 relative">
            <video width="100%" height="100%" autoplay muted loop playsinline class="object-cover w-full h-full">

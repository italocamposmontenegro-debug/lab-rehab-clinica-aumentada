---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/italo-profile.jpg';
import logo1 from '../assets/logos/logo-1.jpg';
import logo2 from '../assets/logos/logo-2.png';
import logo3 from '../assets/logos/logo-3.jpg';
import logo4 from '../assets/logos/logo-4.jpg';
import logo5 from '../assets/logos/logo-5.jpg';
const base = import.meta.env.BASE_URL;
---

<Layout>
  <!-- ============================================================== -->
  <!-- NAVBAR -->
  <!-- ============================================================== -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-neutral-100 transition-all duration-300">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="#inicio" class="font-serif text-lg font-semibold text-neutral-900 tracking-tight hover:text-gold-600 transition-colors">
        Laboratorio RCA
      </a>
      <!-- Mobile menu button -->
      <button id="menu-toggle" class="md:hidden p-2 text-neutral-600 hover:text-gold-600 transition-colors" aria-label="Abrir menú de navegación">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-neutral-500">
        <li><a href="#laboratorio" class="hover:text-gold-600 transition-colors">Laboratorio</a></li>
        <li><a href="#investigacion" class="hover:text-gold-600 transition-colors">Investigación</a></li>
        <li><a href="#simulacion" class="hover:text-gold-600 transition-colors">Simulación</a></li>
        <li><a href="#herramientas" class="hover:text-gold-600 transition-colors">Herramientas</a></li>
        <li><a href="#sobre-mi" class="hover:text-gold-600 transition-colors">Sobre mí</a></li>
        <li><a href="#contacto" class="hover:text-gold-600 transition-colors">Contacto</a></li>
      </ul>
    </div>
    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-100 bg-white">
      <ul class="flex flex-col px-6 py-4 gap-4 text-sm font-medium text-neutral-600">
        <li><a href="#laboratorio" class="block hover:text-gold-600 transition-colors">Laboratorio</a></li>
        <li><a href="#investigacion" class="block hover:text-gold-600 transition-colors">Investigación</a></li>
        <li><a href="#simulacion" class="block hover:text-gold-600 transition-colors">Simulación</a></li>
        <li><a href="#practica" class="block hover:text-gold-600 transition-colors">Práctica clínica</a></li>
        <li><a href="#docencia" class="block hover:text-gold-600 transition-colors">Docencia</a></li>
        <li><a href="#herramientas" class="block hover:text-gold-600 transition-colors">Herramientas</a></li>
        <li><a href="#sobre-mi" class="block hover:text-gold-600 transition-colors">Sobre mí</a></li>
        <li><a href="#contacto" class="block hover:text-gold-600 transition-colors">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- ============================================================== -->
  <!-- SECTION 1: HOME / HERO -->
  <!-- ============================================================== -->
  <section id="inicio" class="min-h-screen flex items-center justify-center pt-20 pb-16 px-6">
    <div class="max-w-3xl mx-auto text-center fade-in">
      <!-- Subtle gold line -->
      <div class="w-12 h-px bg-gold-400 mx-auto mb-8"></div>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold text-neutral-900 leading-tight mb-6">
        Laboratorio de Rehabilitación Clínica Aumentada
      </h1>
      <p class="text-lg md:text-xl text-neutral-500 leading-relaxed mb-6 max-w-2xl mx-auto">
        Diseño sistemas clínicos aumentados de evaluación, intervención y aprendizaje en rehabilitación, integrando inteligencia artificial, simulación clínica e investigación aplicada.
      </p>
      
      <!-- Credentials Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-50 border border-neutral-200 rounded-full mb-8">
        <span class="w-2 h-2 rounded-full bg-gold-500"></span>
        <span class="text-xs font-medium text-neutral-600 tracking-wide uppercase">Magíster en Neurorehabilitación · Especialista Certificado</span>
      </div>

      <p class="text-base text-neutral-600 leading-relaxed mb-10 max-w-2xl mx-auto text-justify">
        El Laboratorio es un entorno educativo-profesional orientado a clínicos que buscan incorporar inteligencia artificial de forma rigurosa y responsable. Aquí no se enseñan aplicaciones ni modelos aislados: se aprende, haciendo, a diseñar y utilizar sistemas clínicos aumentados, capaces de adaptarse a distintos contextos, tecnologías y necesidades reales de práctica clínica.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://wa.me/56977402337?text=Hola%20%C3%8Dtalo%2C%20me%20interesa%20conocer%20m%C3%A1s%20sobre%20el%20Laboratorio%20y%20c%C3%B3mo%20puedo%20participar." class="inline-flex items-center px-8 py-3.5 bg-neutral-900 text-white text-sm font-medium rounded-none hover:bg-gold-700 transition-colors duration-300">
          Postular al Laboratorio
        </a>
        <a href="#investigacion" class="inline-flex items-center px-6 py-3.5 border border-neutral-300 text-neutral-700 text-sm font-medium rounded-none hover:border-gold-400 hover:text-gold-700 transition-colors duration-300">
          Explorar investigaciones
        </a>
        <a href="#simulacion" class="inline-flex items-center px-6 py-3.5 border border-neutral-300 text-neutral-700 text-sm font-medium rounded-none hover:border-gold-400 hover:text-gold-700 transition-colors duration-300">
          Ver simuladores clínicos
        </a>
      </div>
    </div>
    </div>

    <!-- Trust Bar -->
    <div class="mt-20 border-t border-neutral-100 pt-10 max-w-5xl mx-auto fade-in">
      <p class="text-xs text-center text-neutral-400 uppercase tracking-widest mb-6">Trayectoria y Colaboraciones</p>
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
        <Image src={logo1} alt="Institución Colaboradora" class="h-12 w-auto object-contain" />
        <Image src={logo2} alt="Institución Colaboradora" class="h-12 w-auto object-contain" />
        <Image src={logo3} alt="Institución Colaboradora" class="h-10 w-auto object-contain" />
        <Image src={logo4} alt="Institución Colaboradora" class="h-12 w-auto object-contain" />
        <Image src={logo5} alt="Institución Colaboradora" class="h-12 w-auto object-contain" />
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 2: EL LABORATORIO -->
  <!-- ============================================================== -->
  <section id="laboratorio" class="py-24 px-6 bg-neutral-50">
    <div class="max-w-4xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-8">El Laboratorio</h2>

      <!-- Qué es -->
      <p class="text-base text-neutral-700 leading-relaxed mb-10 text-justify">
        El Laboratorio de Rehabilitación Clínica Aumentada es un sistema educativo continuo donde clínicos desarrollan la capacidad de pensar, construir y evaluar sistemas clínicos aumentados, utilizando inteligencia artificial como soporte para la toma de decisiones clínicas, el análisis de datos y el diseño terapéutico.
      </p>

      <!-- Grid: Qué NO es / Qué SÍ es -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="p-8 bg-white border border-neutral-200">
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-4">Qué NO es</h3>
          <ul class="space-y-2 text-neutral-600 text-sm leading-relaxed">
            <li class="flex items-start gap-2"><span class="text-neutral-400 mt-0.5">—</span> No es un curso tradicional.</li>
            <li class="flex items-start gap-2"><span class="text-neutral-400 mt-0.5">—</span> No es una colección de aplicaciones.</li>
            <li class="flex items-start gap-2"><span class="text-neutral-400 mt-0.5">—</span> No automatiza decisiones clínicas.</li>
          </ul>
        </div>
        <div class="p-10 bg-white border border-neutral-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
          <h3 class="font-serif text-xl font-semibold text-neutral-900 mb-8 text-center text-balance">Lo que lograrás (Beneficios)</h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold-50 flex items-center justify-center mt-0.5">
                <span class="text-gold-600 text-sm">✓</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-[250px_1fr] gap-2 md:gap-6 items-baseline">
                <strong class="text-neutral-900 font-medium">Diferenciación Clínica</strong>
                <span class="text-neutral-600 text-sm leading-relaxed text-justify">Domina herramientas que el 99% de tus colegas ignora.</span>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold-50 flex items-center justify-center mt-0.5">
                <span class="text-gold-600 text-sm">✓</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-[250px_1fr] gap-2 md:gap-6 items-baseline">
                <strong class="text-neutral-900 font-medium">Eficiencia Real</strong>
                <span class="text-neutral-600 text-sm leading-relaxed text-justify">Reduce tiempos de análisis y documentación sin perder calidad humana.</span>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold-50 flex items-center justify-center mt-0.5">
                <span class="text-gold-600 text-sm">✓</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-[250px_1fr] gap-2 md:gap-6 items-baseline">
                <strong class="text-neutral-900 font-medium">Innovación Basada en Evidencia</strong>
                <span class="text-neutral-600 text-sm leading-relaxed text-justify">Integra IA no por moda, sino para resolver problemas clínicos complejos.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Cómo se aprende -->
      <div class="mb-12">
        <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-4">Cómo se aprende</h3>
        <p class="text-sm text-neutral-600 leading-relaxed text-justify">
          El aprendizaje es práctico y progresivo, utilizando casos reales como: análisis del control postural mediante sistemas de COP con hardware accesible; diseño de rehabilitación de extremidad superior apoyada por IA; construcción de sistemas de evaluación clínica de variables complejas, como la sialorrea.
        </p>
      </div>

      <!-- Qué incluye -->
      <div class="mb-12">
        <h3 class="font-serif text-lg font-semibold text-neutral-900 mb-4">Qué incluye</h3>
        <ul class="space-y-2 text-neutral-600 text-sm leading-relaxed">
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Curso base de entrada al Laboratorio.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Acceso continuo al entorno del Laboratorio.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Casos clínicos documentados.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Sistemas clínicos aumentados listos para explorar y adaptar.</li>
          <li class="flex items-start gap-2"><span class="text-gold-500 mt-0.5">✦</span> Actualizaciones periódicas según avances clínicos y tecnológicos.</li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a href="https://wa.me/56977402337?text=Hola%20%C3%8Dtalo%2C%20quiero%20informaci%C3%B3n%20sobre%20c%C3%B3mo%20ingresar%20al%20Laboratorio." class="inline-flex items-center gap-2 px-8 py-3.5 bg-neutral-900 text-white text-sm font-medium rounded-none hover:bg-gold-700 transition-colors duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Hablar por WhatsApp
        </a>
      </div>

      <!-- Nota ética -->
      <p class="mt-10 text-xs text-neutral-400 text-center leading-relaxed border-t border-neutral-200 pt-6">
        Uso educativo y formativo. No entrega diagnóstico ni recomendaciones clínicas personalizadas para pacientes. La responsabilidad clínica recae siempre en el profesional tratante.
      </p>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 3: INVESTIGACIÓN -->
  <!-- ============================================================== -->
  <section id="investigacion" class="py-24 px-6">
    <div class="max-w-5xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-4">Investigación</h2>
      <p class="text-base text-neutral-600 leading-relaxed mb-12 max-w-3xl text-justify">
        Mi trabajo de investigación se centra en el impacto real de los sistemas clínicos aumentados por IA en educación superior y formación clínica, con especial énfasis en tutores virtuales, simulación clínica y aprendizaje autónomo guiado.
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <article class="border border-neutral-200 p-8 hover:border-gold-300 transition-colors duration-300 group">
          <span class="text-xs font-medium text-gold-600 uppercase tracking-widest">Estudio 1</span>
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mt-3 mb-4 leading-snug">Etapa formativa y preferencia por el estilo de tutor virtual en estudiantes de Kinesiología</h3>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Propósito</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Analizar si el nivel formativo (6° vs. 8° semestre) se asocia con la preferencia por un estilo de tutor virtual directivo o socrático.</p>
          </div>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Diseño</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Estudio observacional transversal.</p>
          </div>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Hallazgos clave</p>
            <ul class="space-y-1 text-sm text-neutral-600">
              <li>• La etapa formativa influye en la preferencia por el tipo de tutor virtual.</li>
              <li>• Respalda la necesidad de diseñar tutores adaptativos según nivel del estudiante.</li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Contribución</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Evidencia para el diseño diferenciado de tutores GPT según etapa formativa.</p>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="border border-neutral-200 p-8 hover:border-gold-300 transition-colors duration-300 group">
          <span class="text-xs font-medium text-gold-600 uppercase tracking-widest">Estudio 2</span>
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mt-3 mb-4 leading-snug">Uso situado de un tutor GPT y reducción de ansiedad en práctica clínica</h3>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Propósito</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Evaluar el efecto de un tutor GPT contextualizado sobre la ansiedad percibida en estudiantes en práctica profesional.</p>
          </div>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Diseño</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Estudio observacional transversal.</p>
          </div>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Hallazgos clave</p>
            <ul class="space-y-1 text-sm text-neutral-600">
              <li>• El tutor GPT situado contribuye a reducir la ansiedad en contextos de práctica clínica.</li>
              <li>• Demuestra que cómo se usa la IA es más importante que cuánto se usa.</li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Contribución</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Respalda la necesidad de formar en alfabetización en IA para maximizar valor pedagógico.</p>
          </div>
        </article>

        <!-- Card 3 -->
        <article class="border border-neutral-200 p-8 hover:border-gold-300 transition-colors duration-300 group">
          <span class="text-xs font-medium text-gold-600 uppercase tracking-widest">Estudio 3</span>
          <h3 class="font-serif text-lg font-semibold text-neutral-900 mt-3 mb-4 leading-snug">Alfabetización en IA y experiencia con tutor GPT en educación superior</h3>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Propósito</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Analizar cómo la alfabetización en IA, la intensidad de uso y las conductas de verificación influyen en la experiencia subjetiva con un tutor virtual GPT.</p>
          </div>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Diseño</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Estudio transversal (cohorte 2025); n = 23; Regresión lineal múltiple.</p>
          </div>
          <div class="mb-4">
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Hallazgos clave</p>
            <ul class="space-y-1 text-sm text-neutral-600">
              <li>• Asociación significativa entre alfabetización y motivación/calidad percibida.</li>
              <li>• La intensidad de uso no fue un predictor relevante.</li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-medium text-neutral-500 uppercase tracking-wider mb-1">Contribución</p>
            <p class="text-sm text-neutral-600 leading-relaxed">Demuestra que cómo se usa la IA es más importante que cuánto se usa, respaldando la formación en alfabetización en IA.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 4: SIMULACIÓN CLÍNICA -->
  <!-- ============================================================== -->
  <section id="simulacion" class="py-24 px-6 bg-neutral-50">
    <div class="max-w-4xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-6">Simulación clínica y tutores virtuales</h2>
      <p class="text-base text-neutral-700 leading-relaxed mb-10 text-justify">
        La simulación clínica es una de las formas más concretas de materializar un sistema clínico aumentado. Desarrollo y utilizo pacientes/usuarios simulados basados en IA, entrevistas clínicas interactivas y evaluación formativa estructurada posterior a la interacción, para entrenar toma de decisiones y comunicación clínica en entornos controlados.
      </p>
      <a href="https://chatgpt.com/g/g-6977a771081c81919254d4020a20a7c5-simulador-valentina-soto" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3.5 border border-neutral-300 text-neutral-700 text-sm font-medium rounded-none hover:border-gold-400 hover:text-gold-700 transition-colors duration-300">
        Ver demostración — Simulador Valentina Soto
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SECTION 5: PRÁCTICA CLÍNICA -->
  <!-- ============================================================== -->
  <section id="practica" class="py-24 px-6">
    <div class="max-w-4xl mx-auto fade-in">
      <div class="w-12 h-px bg-gold-400 mb-8"></div>
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-12">Práctica clínica</h2>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Sanatorio Marítimo -->
        <div class="p-8 border border-neutral-200 hover:border-gold-300 transition-colors duration-300">
          <span class="text-xs font-medium text-gold-600 uppercase tracking-widest">2010 – 2022</span>
          <h3 class="font-serif text-xl font-semibold text-neutral-900 mt-3 mb-2">Sanatorio Marítimo San Juan de Dios</h3>
          <p class="text-sm font-medium text-neutral-500 mb-4">Kinesiólogo · Encargado equipo de salud</p>
          <p class="text-sm text-neutral-600 leading-relaxed text-justify">
            Apoyo a inclusión educativa de personas con discapacidad múltiple y severa a lo largo del ciclo vital, implementando estrategias que habilitaron participación activa en comunidad.
          </p>
        </div>

        <!-- Instituto Luis Krebs -->
        <div class="p-8 border border-neutral-200 hover:border-gold-300 transition-colors duration-300">
          <span class="text-xs font-medium text-gold-600 uppercase tracking-widest">2022 – 2024</span>

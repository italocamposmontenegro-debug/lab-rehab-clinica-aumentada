---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import AnimatedButton from '../components/AnimatedButton.astro';
import AnimatedCard from '../components/AnimatedCard.astro';
import LabTimeline from '../components/LabTimeline.astro';
import MotionSection from '../components/MotionSection.astro';
import ProductCard from '../components/ProductCard.astro';
import ResearchCard from '../components/ResearchCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import profileImage from '../assets/italo-profile.jpg';
import logo1 from '../assets/logos/logo-1.jpg';
import logo2 from '../assets/logos/logo-2.png';
import logo3 from '../assets/logos/logo-3.jpg';
import logo4 from '../assets/logos/logo-4.jpg';
import logo5 from '../assets/logos/logo-5.jpg';

const navItems = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#soluciones', label: 'Soluciones' },
  { href: '#laboratorio', label: 'Laboratorio' },
  { href: '#aplicaciones', label: 'Aplicaciones' },
  { href: '#investigacion', label: 'Investigación' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#contacto', label: 'Contacto' },
];

const logos = [logo1, logo2, logo3, logo4, logo5];

const solutions = [
  {
    title: 'Tutores virtuales académicos',
    description: 'Tutores especializados para apoyar aprendizaje clínico, estudio guiado, práctica profesional y acompañamiento docente.',
    evidence: 'Arquitectura nutrida por estudios sobre tutores virtuales y experiencia académica en contextos reales de formación.',
    href: '#contacto',
    cta: 'Ver integración',
  },
  {
    title: 'Simuladores clínicos conversacionales',
    description: 'Pacientes simulados y escenarios de interacción clínica para entrenar entrevista, comunicación, razonamiento y evaluación formativa.',
    href: '#simulacion',
    cta: 'Explorar simuladores',
  },
  {
    title: 'Sistemas de seguimiento académico',
    description: 'Herramientas para apoyar categorización, seguimiento y comprensión de trayectorias estudiantiles en educación superior.',
    href: '#aplicaciones',
    cta: 'Ver plataforma',
  },
  {
    title: 'Soluciones clínicas personalizadas',
    description: 'Aplicaciones locales, sistemas de registro, evaluación digital y herramientas adaptadas a necesidades específicas de rehabilitación y formación.',
    href: '#aplicaciones',
    cta: 'Ver catálogo de apps',
  },
];

const labTimelineItems = [
  {
    number: '01',
    title: 'Diferenciación clínica',
    description: 'Integra tecnología avanzada en la práctica diaria con criterio clínico, lenguaje profesional y una posición clara frente a la evidencia.',
  },
  {
    number: '02',
    title: 'Eficiencia real',
    description: 'Reduce fricción en análisis, documentación y seguimiento sin perder calidad humana ni responsabilidad profesional.',
  },
  {
    number: '03',
    title: 'Innovación en evidencia',
    description: 'Usa IA para resolver problemas clínicos complejos con validación empírica, diseño progresivo y evaluación continua.',
  },
];

const applications = [
  {
    title: 'HandMov',
    category: 'Rehabilitación motriz bimanual',
    description: 'Aplicación terapéutica con visión computacional para entrenamiento motriz bimanual y oculo-manual sin contacto, seguimiento de sesión y exportación de métricas clínicas.',
    status: 'Implementable',
    video: '/Handmov.mp4',
    href: 'https://handmov.italocampos.cl',
    cta: 'Explorar aplicación',
    external: true,
  },
  {
    title: 'Test Salival',
    category: 'Evaluación de disfunción salival',
    description: 'Digitalización del protocolo de evaluación para sialorrea. Optimiza la recolección de datos mediante cronómetros y escalas de impacto validadas (DQ5).',
    status: 'Demostración',
    video: '/test_salival.mp4',
    href: 'https://test-salival.italocampos.cl',
    cta: 'Explorar aplicación',
    external: true,
  },
  {
    title: 'FallRisk Lab',
    category: 'Análisis predictivo de caídas',
    description: 'Laboratorio digital para cuantificar factores de riesgo de caídas en adultos mayores, facilitando el diseño de intervenciones motoras oportunas y basadas en datos.',
    status: 'Implementable',
    video: '/Fallrisk.mp4',
    href: '#contacto',
    cta: 'Solicitar demo',
  },
  {
    title: 'RehAPP',
    category: 'Gestión clínica',
    description: 'Ecosistema unificado para seguimiento de rehabilitación. Estandariza la carga administrativa, informes y evolución de pacientes en entornos clínicos y centros de práctica.',
    status: 'Adaptable',
    video: '/Rehapp.mp4',
    href: 'https://rehapp.italocampos.cl',
    cta: 'Explorar aplicación',
    external: true,
  },
  {
    title: 'Indicador de Egreso',
    category: 'Seguimiento académico',
    description: 'Sistema de categorización de trayectorias estudiantiles y cálculo de competencias de egreso, enfocado en optimizar el seguimiento docente en educación superior.',
    status: 'Implementable',
    video: '/Indicador_de_egreso.mp4',
    href: '#contacto',
    cta: 'Solicitar demo',
  },
];

const researchItems = [
  {
    study: 'Estudio 1',
    title: 'Etapa formativa y preferencia por el estilo de tutor virtual en estudiantes de Kinesiología',
    purpose: 'Analizar si el nivel formativo (6° vs. 8° semestre) se asocia con la preferencia por un estilo de tutor virtual directivo o socrático.',
    design: 'Estudio observacional transversal.',
    findings: [
      'La etapa formativa influye en la preferencia por el tipo de tutor virtual.',
      'Respalda la necesidad de diseñar tutores adaptativos según nivel del estudiante.',
    ],
    contribution: 'Evidencia para el diseño diferenciado de tutores GPT según etapa formativa.',
  },
  {
    study: 'Estudio 2',
    title: 'Uso situado de un tutor GPT y reducción de ansiedad en práctica clínica',
    purpose: 'Evaluar el efecto de un tutor GPT contextualizado sobre la ansiedad percibida en estudiantes en práctica profesional.',
    design: 'Estudio observacional transversal.',
    findings: [
      'El tutor GPT situado contribuye a reducir la ansiedad en contextos de práctica clínica.',
      'Demuestra que cómo se usa la IA es más importante que cuánto se usa.',
    ],
    contribution: 'Respalda la necesidad de formar en alfabetización en IA para maximizar valor pedagógico.',
  },
  {
    study: 'Estudio 3',
    title: 'Alfabetización en IA y experiencia con tutor GPT en educación superior',
    purpose: 'Analizar cómo la alfabetización en IA, la intensidad de uso y las conductas de verificación influyen en la experiencia subjetiva con un tutor virtual GPT.',
    design: 'Estudio transversal (cohorte 2025); n = 23; Regresión lineal múltiple.',
    findings: [
      'Asociación significativa entre alfabetización y motivación/calidad percibida.',
      'La intensidad de uso no fue un predictor relevante.',
    ],
    contribution: 'Demuestra que cómo se usa la IA es más importante que cuánto se usa, respaldando la formación en alfabetización en IA.',
  },
];

const clinicalPractice = [
  {
    period: '2010-2022',
    title: 'Sanatorio Marítimo San Juan de Dios',
    role: 'Kinesiólogo · Encargado equipo de salud',
    description: 'Apoyo a inclusión educativa de personas con discapacidad múltiple y severa a lo largo del ciclo vital, implementando estrategias que habilitaron participación activa en comunidad.',
  },
  {
    period: '2022-2024',
    title: 'Instituto de Neurorehabilitación Luis Krebs',
    role: 'Kinesiólogo · Docente clínico',
    description: 'Rehabilitación integral en trastornos sensorioperceptivos, cognitivos y/o motores; exploración de alternativas terapéuticas basadas en evidencia y personalización.',
  },
];

const educationItems = [
  {
    title: 'Universidad Viña del Mar - Escuela de Kinesiología',
    meta: 'Cargo académico · Desde 2024 a la fecha',
    description: 'Docencia en neurorrehabilitación, integración de IA en formación clínica y diseño de sistemas educativos aumentados.',
  },
  {
    title: 'Colaboraciones docentes clínicas',
    meta: 'Desde 2013',
    description: 'Colaboración como docente clínico con Universidad Santo Tomás, Universidad de Playa Ancha, Universidad Andrés Bello y Universidad Viña del Mar.',
  },
];

const tools = [
  {
    title: 'Tutor virtual de demostración pública',
    description: 'Tutor de internado en kinesiología. Guía la reflexión clínica mediante cuestionamiento socrático sin dar respuestas directas.',
    note: 'Arquitectura informada por estudios previos sobre tutoría virtual y experiencia académica aplicada.',
    href: 'https://chatgpt.com/g/g-69af7564ee6c8191836a581664b84f19-sofia-tutor-de-internado-kinesiologia-uvm-2026',
    cta: 'Abrir demostrador',
  },
  {
    title: 'Simulador Clínico (Valentina Soto)',
    description: 'GPT customizado para simulación clínica en dolor crónico y comunicación. Optimiza tu capacidad clínica en situaciones complejas.',
    href: 'https://chatgpt.com/g/g-6977a771081c81919254d4020a20a7c5-simulador-valentina-soto',
    cta: 'Abrir GPT',
  },
  {
    title: 'Tutor Neurociencia del Dolor',
    description: 'Tutor especializado en neurociencia del dolor persistente. Profundiza en fenómenos fisiológicos, evaluación y estrategias terapéuticas.',
    href: 'https://chatgpt.com/g/g-689cb093d99481919eca48333e0ef7e3-tutor-de-neurociencia-del-dolor',
    cta: 'Abrir GPT',
  },
  {
    title: 'Tutor Curso VMF',
    description: 'Asistente de autoaprendizaje con experto en Vibración Muscular Focal aplicada a neurorehabilitación.',
    href: 'https://chatgpt.com/g/g-67aa435162988191bd96e71f90f4bcb1-curso-de-autoaprendizaje-de-vmf-en-neurorehab',
    cta: 'Abrir GPT',
  },
];
---

<Layout>
  <header id="navbar" class="fixed left-0 right-0 top-0 z-50 border-b border-white/10 bg-neutral-950/55 text-white backdrop-blur-md transition-all duration-300">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4" aria-label="Navegación principal">
      <a href="#inicio" class="font-serif text-lg font-semibold tracking-tight text-white transition-colors duration-300 hover:text-gold-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-4 focus-visible:ring-offset-neutral-950">
        Laboratorio RCA
      </a>

      <button id="menu-toggle" class="inline-flex min-h-11 min-w-11 items-center justify-center border border-white/15 text-neutral-100 transition-colors duration-300 hover:border-gold-400 hover:text-gold-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 focus-visible:ring-offset-4 focus-visible:ring-offset-neutral-950 md:hidden" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Abrir menú de navegación">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>

      <ul class="hidden items-center gap-7 text-sm font-medium text-neutral-300 md:flex">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link transition-colors duration-300 hover:text-gold-200 focus:outline-none focus-visible:text-gold-200">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div id="mobile-menu" class="hidden border-t border-white/10 bg-neutral-950/95 px-6 pb-5 pt-2 backdrop-blur md:hidden">
      <ul class="mx-auto flex max-w-6xl flex-col gap-1 text-sm font-medium text-neutral-200">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="block border-b border-white/5 px-1 py-3 transition-colors duration-300 hover:text-gold-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-300">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <main class="overflow-x-hidden bg-white">
    <section id="inicio" class="hero-shell relative isolate overflow-hidden px-6 pb-16 pt-32 text-white md:pb-20 md:pt-36">
      <div class="hero-network pointer-events-none absolute inset-0 opacity-80" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-b from-transparent to-neutral-950" aria-hidden="true"></div>

      <div class="relative mx-auto flex min-h-[78svh] max-w-6xl flex-col justify-center">
        <div class="max-w-[22rem] sm:max-w-4xl">
          <div class="clinical-rule mb-8 h-px w-24" data-motion="fadeIn"></div>
          <p class="mb-5 max-w-full text-xs font-bold uppercase tracking-[0.16em] text-gold-200 sm:tracking-[0.28em]" data-motion="fadeUp" style="--motion-delay: 80ms">
            Laboratorio de Rehabilitación Clínica Aumentada
          </p>
          <h1 class="text-balance max-w-full font-serif text-[2rem] font-semibold leading-[1.05] tracking-normal text-white sm:text-4xl md:text-6xl lg:text-7xl" data-motion="fadeUp" style="--motion-delay: 160ms">
            Sistemas clínico-tecnológicos aplicados a rehabilitación y educación en salud
          </h1>
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-neutral-200 md:mt-7 md:text-xl" data-motion="fadeUp" style="--motion-delay: 240ms">
            Diseño e implemento tutores virtuales, simuladores clínicos, herramientas digitales y sistemas aplicados para equipos docentes, instituciones y profesionales de la rehabilitación.
          </p>
          <p class="mt-5 max-w-3xl border-l border-gold-300/80 pl-5 text-sm font-medium leading-relaxed text-neutral-300 md:mt-6 md:text-base" data-motion="fadeUp" style="--motion-delay: 320ms">
            Este no es solo un portafolio. Es una infraestructura pública de trabajo clínico-tecnológico: práctica clínica, docencia, IA, simulación, datos e investigación aplicada en un mismo ecosistema.
          </p>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-9" data-motion="fadeUp" style="--motion-delay: 400ms">
            <AnimatedButton href="#soluciones" variant="gold" class="sm:w-auto">Ver soluciones</AnimatedButton>
            <AnimatedButton href="#contacto" variant="secondary" class="sm:w-auto">Solicitar reunión diagnóstica</AnimatedButton>
            <AnimatedButton href="#investigacion" variant="secondary" class="sm:w-auto">Explorar investigación</AnimatedButton>
          </div>
        </div>

        <div class="mt-14 border-t border-white/10 pt-7 md:mt-20" data-motion="fadeIn" style="--motion-delay: 520ms">
          <p class="mb-6 text-xs font-semibold uppercase tracking-[0.24em] text-neutral-400">Trayectoria y colaboraciones</p>
          <div class="flex flex-wrap items-center gap-7 opacity-70 grayscale transition duration-500 hover:opacity-100 hover:grayscale-0 md:gap-12">
            {logos.map((logo) => (
              <Image src={logo} alt="Institución colaboradora" class="h-8 w-auto object-contain md:h-11" loading="lazy" />
            ))}
          </div>
        </div>
      </div>
    </section>

    <MotionSection id="soluciones" class="bg-white" labelledBy="soluciones-title">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          id="soluciones-title"
          eyebrow="Soluciones"
          title="Soluciones para instituciones y clínicos"
          lead="Diseño arquitecturas de inteligencia artificial que se adaptan a necesidades clínicas y académicas, optimizando formación, seguimiento e intervención."
        />
        <AnimatedButton href="#contacto" class="hidden shrink-0 md:inline-flex">Solicitar implementación</AnimatedButton>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2" data-stagger>
        {solutions.map((solution) => (
          <AnimatedCard class="flex min-h-[260px] flex-col justify-between">
            <div>
              <span class="mb-6 block h-px w-14 bg-gold-400/80"></span>
              <h3 class="font-serif text-2xl font-semibold text-neutral-950">{solution.title}</h3>
              <p class="mt-5 text-sm leading-relaxed text-neutral-600">{solution.description}</p>
              {solution.evidence && (
                <p class="mt-5 border-l border-gold-400 pl-4 text-xs font-medium leading-relaxed text-neutral-600">
                  {solution.evidence}
                </p>
              )}
            </div>
            <a href={solution.href} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-gold-700 transition-colors hover:text-gold-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500">
              {solution.cta}
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </AnimatedCard>
        ))}
      </div>

      <div class="mt-8 md:hidden">
        <AnimatedButton href="#contacto" class="w-full">Solicitar implementación</AnimatedButton>
      </div>
    </MotionSection>

    <MotionSection id="laboratorio" class="bg-neutral-950 text-white" innerClass="mx-auto max-w-6xl px-6" labelledBy="laboratorio-title">
      <SectionHeading
        id="laboratorio-title"
        eyebrow="Núcleo estratégico"
        title="El Laboratorio"
        inverse
        lead="El Laboratorio de Rehabilitación Clínica Aumentada es un sistema educativo continuo donde clínicos aprenden a pensar, construir y evaluar sistemas clínicos aumentados con inteligencia artificial, datos y simulación."
      />

      <div class="mt-14">
        <LabTimeline items={labTimelineItems} />
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="border border-white/10 bg-white/[0.045] p-7 md:p-9" data-motion="fadeUp">
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-300">Qué es</p>
          <h3 class="mt-4 font-serif text-2xl font-semibold text-white">Un entorno para transformar fenómenos clínicos complejos en sistemas evaluables</h3>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <div>
              <h4 class="text-sm font-semibold text-white">Lo que sí es</h4>
              <ul class="mt-4 space-y-3 text-sm leading-relaxed text-neutral-300">
                <li>Un espacio de experimentación clínica controlada y rigurosa.</li>
                <li>Un sistema de aprendizaje práctico y progresivo con casos reales.</li>
                <li>Una integración de IA como extensión del razonamiento clínico.</li>
              </ul>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-neutral-300">Lo que no es</h4>
              <ul class="mt-4 space-y-3 text-sm leading-relaxed text-neutral-400">
                <li>No es un curso tradicional pasivo ni teórico.</li>
                <li>No es una colección de aplicaciones o prompts genéricos.</li>
                <li>No busca automatizar la decisión, sino potenciarla.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="space-y-5" data-stagger>
          <AnimatedCard tone="dark">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold-300">Cómo se aprende</p>
            <p class="mt-4 text-sm leading-relaxed text-neutral-300">
              El aprendizaje utiliza casos reales: análisis de control postural mediante sistemas de COP con hardware accesible, rehabilitación de extremidad superior apoyada por IA y evaluación clínica digital de variables complejas como la sialorrea.
            </p>
          </AnimatedCard>
          <AnimatedCard tone="dark">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold-300">Qué incluye</p>
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-300">
              <li>Curso base de entrada al Laboratorio.</li>
              <li>Acceso continuo al entorno del Laboratorio.</li>
              <li>Casos clínicos documentados y sistemas aumentados adaptables.</li>
              <li>Actualizaciones periódicas según avances clínicos y tecnológicos.</li>
            </ul>
          </AnimatedCard>
        </div>
      </div>

      <div class="mt-12 border border-gold-300/25 bg-gold-300/[0.07] p-7 md:p-9" data-motion="fadeUp">
        <div class="grid gap-7 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h3 class="font-serif text-2xl font-semibold text-white">Del laboratorio a la implementación</h3>
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-neutral-300">
              Además del entorno formativo, el laboratorio desarrolla y adapta soluciones concretas para docencia, simulación, seguimiento académico y rehabilitación clínica, integrando evidencia empírica con experiencia académica y diseño aplicado.
            </p>
          </div>
          <AnimatedButton href="https://wa.me/56977402337?text=Hola%20%C3%8Dtalo%2C%20quiero%20informaci%C3%B3n%20sobre%20c%C3%B3mo%20ingresar%20al%20Laboratorio." external variant="gold">
            Hablar por WhatsApp
          </AnimatedButton>
        </div>
      </div>

      <p class="mt-8 border-t border-white/10 pt-6 text-center text-xs leading-relaxed text-neutral-500">
        Uso educativo y formativo. No entrega diagnóstico ni recomendaciones clínicas personalizadas para pacientes. La responsabilidad clínica recae siempre en el profesional tratante.
      </p>
    </MotionSection>

    <MotionSection id="aplicaciones" class="bg-neutral-50" labelledBy="aplicaciones-title">
      <SectionHeading
        id="aplicaciones-title"
        eyebrow="Aplicaciones"
        title="Aplicaciones y desarrollos"
        lead="Catálogo de soluciones activas implementadas como parte de las capacidades del laboratorio. Integran lógica clínica, visión computacional y modelos de lenguaje, listas para adopción y adaptación institucional."
      />

      <div class="mt-14 grid gap-7 md:grid-cols-2 lg:grid-cols-3" data-stagger>
        {applications.map((app) => (
          <ProductCard {...app} />
        ))}
      </div>
    </MotionSection>

    <MotionSection id="investigacion" class="bg-white" labelledBy="investigacion-title">
      <SectionHeading
        id="investigacion-title"
        eyebrow="Evidencia aplicada"
        title="Investigación"
        lead="La investigación funciona como respaldo del laboratorio: orienta el diseño de tutores virtuales, simulación clínica y aprendizaje autónomo guiado en educación superior y formación clínica."
      />

      <div class="mt-14 grid gap-6 lg:grid-cols-3" data-stagger>
        {researchItems.map((item) => (
          <ResearchCard {...item} />
        ))}
      </div>

      <div class="mt-14 border border-neutral-800 bg-neutral-950 p-7 text-center text-white md:p-9" data-motion="fadeUp">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-300">Arquitectura basada en evidencia</p>
        <h3 class="mx-auto mt-4 max-w-3xl font-serif text-2xl font-semibold">Investigación que respalda estas implementaciones</h3>
        <p class="mx-auto mt-5 max-w-3xl text-sm leading-relaxed text-neutral-300">
          Los hallazgos generados en los estudios sobre tutores virtuales orientan el diseño de tutores con arquitectura basada en evidencia, experiencia académica y aplicación institucional.
        </p>
      </div>
    </MotionSection>

    <MotionSection id="simulacion" class="bg-neutral-950 text-white" innerClass="mx-auto max-w-5xl px-6" labelledBy="simulacion-title">
      <SectionHeading
        id="simulacion-title"
        eyebrow="Demo destacada"
        title="Simulación clínica interactiva"
        inverse

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AnimatedButton from '../components/AnimatedButton.astro';
import MotionSection from '../components/MotionSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import profileImage from '../assets/italo-profile.jpg';

const navItems = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#investigacion', label: 'Investigación' },
  { href: '#sistemas', label: 'Sistemas' },
  { href: '#trayectoria', label: 'Trayectoria' },
  { href: '#colaborar', label: 'Colaborar' },
];

const evidenceItems = [
  { value: '15+', label: 'años de experiencia clínica', href: '#trayectoria' },
  { value: '2', label: 'publicaciones científicas en 2026', href: '#publicaciones' },
  {
    value: 'UVM',
    label: 'académico de la Universidad Viña del Mar',
    href: 'https://www.uvm.cl/noticias/academico-uvm-presenta-avances-inteligencia-artificial-aplicada-rehabilitacion-teleton-valparaiso/',
    external: true,
  },
  { value: 'I + I', label: 'investigación e implementación', href: '#sistemas' },
];

const workLines = [
  {
    number: '01',
    title: 'Aprendizaje clínico aumentativo',
    description: 'Estudio y diseño tutores virtuales, simuladores y sistemas educativos que permitan utilizar IA para aprender, practicar y tomar mejores decisiones sin erosionar la autonomía cognitiva del estudiante o profesional.',
    topics: ['Tutores virtuales', 'Simulación clínica', 'Alfabetización en IA', 'Razonamiento clínico', 'Metacognición', 'Delegación cognitiva'],
  },
  {
    number: '02',
    title: 'Rehabilitación aumentativa',
    description: 'Transformo problemas de evaluación y rehabilitación en sistemas digitales que permitan registrar, visualizar o analizar fenómenos clínicos manteniendo al profesional dentro del circuito de decisión.',
    topics: ['HandMov', 'Test Salival', 'Análisis de movimiento', 'Riesgo de caída', 'Evaluación digital', 'Visión computacional'],
  },
  {
    number: '03',
    title: 'Adopción responsable y gobernanza',
    description: 'Trabajo sobre las capacidades que profesionales e instituciones necesitan para integrar inteligencia artificial con criterios de evidencia, ética, seguridad, protección de datos y responsabilidad clínica.',
    topics: ['Alfabetización', 'Adopción institucional', 'Human-in-the-loop', 'Gobernanza', 'Implementación responsable'],
  },
];

const publications = [
  {
    number: '01',
    title: 'Alfabetización en IA y experiencia subjetiva con un tutor virtual basado en GPT en estudiantes de Kinesiología',
    authors: 'Ítalo Campos Montenegro · Maximiliano Martínez Mena',
    journal: 'Revista Española de Educación Médica / Spanish Journal of Medical Education',
    year: '2026',
    doi: '10.6018/edumed.715291',
    articleUrl: 'https://revistas.um.es/edumed/article/view/715291',
    doiUrl: 'https://doi.org/10.6018/edumed.715291',
    design: 'Estudio observacional analítico transversal · n = 23',
    finding: 'La intensidad de uso, la alfabetización autorreportada en IA y las conductas de verificación se asociaron positivamente con la motivación académica en esta cohorte.',
    metrics: [
      ['Intensidad de uso', 'r = 0,703'],
      ['Alfabetización en IA', 'r = 0,767'],
      ['Verificación académica', 'r = 0,773'],
    ],
    interpretation: 'Los resultados sugieren que la experiencia con un tutor virtual depende del modo en que los estudiantes se relacionan con la herramienta y justifican seguir estudiando condiciones de uso, alfabetización y verificación.',
    limitation: 'Estudio exploratorio, transversal y basado en autorreporte. Las asociaciones no demuestran causalidad ni efectividad sobre el rendimiento académico.',
  },
  {
    number: '02',
    title: 'Preferencias declaradas por estilos de tutoría virtual en dos cohortes curriculares de Kinesiología: estudio transversal exploratorio',
    authors: 'Ítalo Campos Montenegro',
    journal: 'Revista Española de Educación Médica / Spanish Journal of Medical Education',
    year: '2026',
    doi: '10.6018/edumed.723391',
    articleUrl: 'https://revistas.um.es/edumed/article/view/723391',
    doiUrl: 'https://doi.org/10.6018/edumed.723391',
    design: 'Estudio transversal exploratorio · 44 de 70 estudiantes invitados · 6.º y 8.º semestre',
    finding: 'La preferencia declarada por el tutor reflexivo-socrático fue reportada por el 10% de los estudiantes de sexto semestre y por el 70,8% de los estudiantes de octavo semestre.',
    metrics: [['Preferencia declarada por tutor reflexivo-socrático', '10% → 70,8%']],
    interpretation: 'Las diferencias observadas generan una hipótesis relevante: la configuración del tutor, el contexto curricular, las características de la tarea y el grado de autonomía esperado podrían influir en la forma en que los estudiantes prefieren utilizar estos sistemas.',
    limitation: 'La asociación se mantuvo significativa después del ajuste mediante regresión logística penalizada de Firth. Las cohortes correspondieron a asignaturas y tutores contextualizados diferentes; la diferencia no puede atribuirse de forma causal al nivel formativo.',
  },
];

const catalogItems = [
  {
    title: 'HandMov',
    status: 'Implementable',
    problem: 'Práctica de movimientos bimanuales y óculo-manuales con registro de sesión.',
    action: 'Propone actividades sin contacto apoyadas por visión computacional y exporta métricas de uso.',
    context: 'Rehabilitación motriz · Aplicación web',
    href: 'https://handmov.italocampos.cl',
    cta: 'Abrir HandMov',
  },
  {
    title: 'FallRisk Lab',
    status: 'Demostrador',
    problem: 'Organización de variables vinculadas al riesgo de caída en personas mayores.',
    action: 'Reúne evaluaciones y visualizaciones para apoyar el análisis profesional del riesgo.',
    context: 'Evaluación digital · Uso exploratorio',
    href: '#contacto',
    cta: 'Consultar por el sistema',
  },
  {
    title: 'RehAPP',
    status: 'Prototipo',
    problem: 'Seguimiento disperso de procesos de rehabilitación y documentación clínica.',
    action: 'Organiza registros, evolución e informes dentro de un flujo digital común.',
    context: 'Gestión clínica · Prototipo navegable',
    href: 'https://rehapp.italocampos.cl',
    cta: 'Abrir RehAPP',
  },
  {
    title: 'Indicador de Egreso',
    status: 'Implementable',
    problem: 'Seguimiento de trayectorias y competencias de egreso en educación superior.',
    action: 'Apoya la categorización y lectura de información académica para equipos docentes.',
    context: 'Educación en salud · Seguimiento académico',
    href: '#contacto',
    cta: 'Consultar por el sistema',
  },
];

const demonstrations = [
  {
    title: 'Simulador clínico: Camila Rojas',
    href: 'https://chatgpt.com/g/g-6977ab21a65c819187cc51635389eff5-simulador-camila-rojas',
  },
  {
    title: 'Simulador clínico: Valentina Soto',
    href: 'https://chatgpt.com/g/g-6977a771081c81919254d4020a20a7c5-simulador-valentina-soto',
  },
  {
    title: 'Tutor de internado en Kinesiología',
    href: 'https://chatgpt.com/g/g-69af7564ee6c8191836a581664b84f19-sofia-tutor-de-internado-kinesiologia-uvm-2026',
  },
  {
    title: 'Tutor de neurociencia del dolor',
    href: 'https://chatgpt.com/g/g-689cb093d99481919eca48333e0ef7e3-tutor-de-neurociencia-del-dolor',
  },
  {
    title: 'Tutor del curso de VMF en neurorehabilitación',
    href: 'https://chatgpt.com/g/g-67aa435162988191bd96e71f90f4bcb1-curso-de-autoaprendizaje-de-vmf-en-neurorehab',
  },
];

const trajectory = [
  {
    period: '2010–2022',
    title: 'Sanatorio Marítimo San Juan de Dios',
    role: 'Kinesiólogo · Encargado de equipo de salud',
    description: 'Trabajo clínico con personas con discapacidad múltiple y severa, sus familias y equipos de apoyo a lo largo del ciclo vital.',
  },
  {
    period: '2022–2024',
    title: 'Instituto de Neurorehabilitación Luis Krebs',
    role: 'Kinesiólogo · Docente clínico',
    description: 'Rehabilitación de trastornos sensorioperceptivos, cognitivos y motores, junto con formación situada de estudiantes.',
  },
  {
    period: '2024–actualidad',
    title: 'Universidad Viña del Mar',
    role: 'Académico · Escuela de Kinesiología',
    description: 'Docencia, investigación y desarrollo de sistemas aplicados a educación en salud y rehabilitación.',
  },
];

const collaborationRoutes = [
  {
    key: 'A',
    title: 'Proponer una colaboración científica',
    audience: 'Investigadores, grupos académicos, universidades, estudiantes de posgrado y equipos interdisciplinarios.',
    text: 'Conversemos sobre preguntas, diseños de estudio o líneas de investigación compartidas.',
    cta: 'Conversar sobre investigación',
    subject: 'Colaboración científica desde italocampos.cl',
    event: 'collaboration_research_click',
  },
  {
    key: 'B',
    title: 'Explorar un problema clínico o educativo',
    audience: 'Universidades, centros clínicos, equipos de rehabilitación y organizaciones.',
    text: 'Podemos explorar si un problema concreto admite investigación, diseño, pilotaje o desarrollo de una solución.',
    cta: 'Explorar colaboración institucional',
    subject: 'Colaboración institucional desde italocampos.cl',
    event: 'collaboration_institution_click',
  },
  {
    key: 'C',
    title: 'Invitarme a conversar o enseñar',
    audience: 'Congresos, seminarios, universidades, organizaciones profesionales y equipos institucionales.',
    text: 'Temas: IA y rehabilitación, educación en salud, aprendizaje clínico aumentativo, delegación cognitiva y adopción responsable.',
    cta: 'Consultar disponibilidad',
    subject: 'Invitación a conferencia o formación desde italocampos.cl',
    event: 'speaking_contact_click',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://italocampos.cl/#person',
      name: 'Ítalo Campos Montenegro',
      alternateName: 'Italo Campos Montenegro',
      url: 'https://italocampos.cl/',
      image: 'https://italocampos.cl/italo-profile.jpg',
      jobTitle: 'Kinesiólogo, académico e investigador',
      affiliation: {
        '@type': 'Organization',
        name: 'Universidad Viña del Mar',
        url: 'https://www.uvm.cl/',
      },
      sameAs: [
        'https://orcid.org/0009-0007-0325-3344',
        'https://www.instagram.com/italo_campos_montenegro/',
        'https://cl.linkedin.com/in/italo-campos-montenegro-789534376',
      ],
      knowsAbout: [
        'Neurorehabilitación',
        'Educación en salud',
        'Inteligencia artificial',
        'Aprendizaje clínico',
        'Rehabilitación aumentativa',
        'Adopción responsable de inteligencia artificial',
      ],
    },
    {
      '@type': 'ScholarlyArticle',
      headline: publications[0].title,
      author: [
        { '@type': 'Person', name: 'Ítalo Campos Montenegro', '@id': 'https://italocampos.cl/#person' },
        { '@type': 'Person', name: 'Maximiliano Martínez Mena' },
      ],
      datePublished: '2026-06-10',
      identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: publications[0].doi },
      publisher: { '@type': 'Organization', name: 'Ediciones de la Universidad de Murcia' },
      isPartOf: { '@type': 'Periodical', name: publications[0].journal },
      url: publications[0].articleUrl,
    },
    {
      '@type': 'ScholarlyArticle',
      headline: publications[1].title,
      author: { '@type': 'Person', name: 'Ítalo Campos Montenegro', '@id': 'https://italocampos.cl/#person' },
      datePublished: '2026-07-28',
      identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: publications[1].doi },
      publisher: { '@type': 'Organization', name: 'Ediciones de la Universidad de Murcia' },
      isPartOf: { '@type': 'Periodical', name: publications[1].journal },
      url: publications[1].articleUrl,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Test Salival',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Web',
      url: 'https://test-salival.italocampos.cl',
      description: 'Sistema digital de apoyo a la evaluación y registro de sialorrea.',
      author: { '@id': 'https://italocampos.cl/#person' },
    },
  ],
};
---

<Layout structuredData={structuredData}>
  <a href="#contenido" class="fixed left-4 top-3 z-[60] -translate-y-24 bg-neutral-950 px-4 py-3 text-sm font-semibold text-white transition-transform focus:translate-y-0">
    Saltar al contenido principal
  </a>

  <header id="navbar" class="fixed inset-x-0 top-0 z-50 border-b border-stone-200/80 bg-stone-50/90 backdrop-blur transition-colors">
    <nav class="section-shell flex min-h-20 items-center justify-between" aria-label="Navegación principal">
      <a href="#inicio" class="font-serif text-xl font-semibold tracking-tight text-neutral-950">
        Ítalo Campos
      </a>

      <button
        id="menu-toggle"
        class="inline-flex min-h-11 items-center justify-center border border-neutral-300 bg-white px-4 text-sm font-semibold text-neutral-950 md:hidden"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <span id="menu-label" aria-hidden="true">Menú</span>
      </button>

      <ul class="hidden items-center gap-8 text-sm font-semibold text-neutral-700 md:flex">
        {navItems.map((item) => (
          <li><a href={item.href} class="border-b border-transparent py-2 transition-colors hover:border-gold-600 hover:text-neutral-950">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div id="mobile-menu" class="hidden border-t border-stone-200 bg-stone-50 px-6 pb-5 md:hidden">
      <ul class="mx-auto max-w-6xl py-2 text-base font-semibold text-neutral-800">
        {navItems.map((item) => (
          <li><a href={item.href} class="block border-b border-stone-200 py-4">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </header>

  <main id="contenido">
    <section id="inicio" class="bg-stone-50 pb-16 pt-32 md:pb-24 md:pt-40" aria-labelledby="hero-title">
      <div class="section-shell grid gap-12 lg:grid-cols-[1.22fr_0.78fr] lg:items-center lg:gap-16">
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-gold-800">Neurorehabilitación · Educación en salud · Inteligencia artificial</p>
          <h1 id="hero-title" class="text-balance mt-7 max-w-4xl font-serif text-[2.55rem] font-semibold leading-[1.05] tracking-[-0.025em] text-neutral-950 sm:text-5xl lg:text-[4rem]">
            Investigo y construyo sistemas para integrar inteligencia artificial en la formación clínica y la rehabilitación.
          </h1>
          <p class="text-pretty mt-7 max-w-3xl text-lg leading-8 text-neutral-700 md:text-xl md:leading-9">
            Soy Ítalo Campos, kinesiólogo, académico e investigador. Conecto experiencia clínica, educación en salud, investigación y desarrollo tecnológico. Me interesa que la inteligencia artificial amplíe nuestras capacidades sin desplazar el criterio ni la responsabilidad profesional.
          </p>
          <p class="mt-6 text-sm font-semibold text-neutral-600">Kinesiólogo · Magíster en Neurorehabilitación · Académico · Investigador</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <AnimatedButton href="#lineas" variant="primary">Conocer mi trabajo</AnimatedButton>
            <AnimatedButton href="#investigacion" variant="secondary">Ver investigación</AnimatedButton>
            <a href="#colaborar" class="quiet-link inline-flex min-h-12 items-center justify-center px-2 text-sm font-semibold text-neutral-700 underline sm:justify-start">
              Explorar colaboración
            </a>
          </div>
        </div>

        <figure class="mx-auto w-full max-w-md border border-gold-400/70 p-4 lg:max-w-none lg:p-5">
          <Image
            src={profileImage}
            alt="Ítalo Campos Montenegro en retrato profesional, de pie y con los brazos cruzados"
            class="block aspect-[4/5] w-full object-cover object-top"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 36vw, (min-width: 640px) 448px, calc(100vw - 48px)"
            loading="eager"
            fetchpriority="high"
            quality={86}
          />
          <figcaption class="text-pretty mt-6 border-l border-gold-500 px-4 text-sm leading-7 text-neutral-600">
            Sistemas aumentativos para el aprendizaje clínico y la rehabilitación, con inteligencia artificial y responsabilidad profesional.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="border-y border-stone-200 bg-white" aria-label="Evidencia profesional destacada">
      <div class="section-shell grid gap-px bg-stone-200 sm:grid-cols-2 lg:grid-cols-4">
        {evidenceItems.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="group flex min-h-36 flex-col items-center justify-center bg-white px-6 py-7 text-center sm:items-start sm:text-left lg:min-h-40"
          >
            <span class="font-serif text-3xl font-semibold text-neutral-950 group-hover:text-gold-800">{item.value}</span>
            <span class="mt-2 max-w-[14rem] text-sm leading-6 text-neutral-600">{item.label}</span>
            {item.external && <span class="sr-only"> (abre en una pestaña nueva)</span>}
          </a>
        ))}
      </div>
    </section>

    <MotionSection class="bg-neutral-950 text-white" innerClass="mx-auto max-w-5xl px-6 md:px-8" labelledBy="pregunta-title">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold-300">Una pregunta que atraviesa mi trabajo</p>
      <h2 id="pregunta-title" class="text-balance mt-7 font-serif text-3xl font-medium leading-tight md:text-5xl">
        ¿Qué capacidades podemos delegar a la inteligencia artificial sin debilitar el razonamiento clínico, la autonomía profesional y la responsabilidad humana?
      </h2>
      <p class="text-pretty mt-8 max-w-3xl text-base leading-8 text-neutral-300 md:text-lg">
        Esta pregunta conecta todo lo que hago: educación en salud, tutores virtuales, simulación clínica, delegación cognitiva, sistemas de evaluación y rehabilitación aumentativa. La tecnología cambia rápido. Mi desafío es decidir qué conviene ampliar, qué podemos delegar y qué debemos seguir sosteniendo como responsabilidad humana.
      </p>
      <p class="mt-7 inline-flex border border-gold-300/30 px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-gold-200">Línea de investigación emergente</p>
    </MotionSection>

    <MotionSection id="lineas" class="bg-white" labelledBy="lineas-title">
      <SectionHeading
        id="lineas-title"
        eyebrow="Tres líneas de trabajo"
        title="Tres formas de abordar una misma preocupación"
        lead="Parto de problemas clínicos, educativos e institucionales concretos. Los investigo, construyo formas de abordarlos y observo qué ocurre al llevarlos a la práctica, siempre con el criterio profesional dentro del proceso."
      />
      <div class="mt-14 grid gap-px overflow-hidden border border-stone-200 bg-stone-200 lg:grid-cols-3">
        {workLines.map((line) => (
          <article data-work-line class="bg-stone-50 p-7 md:p-9">
            <span class="font-serif text-2xl font-semibold text-gold-700">{line.number}</span>
            <h3 class="mt-8 font-serif text-2xl font-semibold leading-tight text-neutral-950">{line.title}</h3>
            <p class="mt-5 text-sm leading-7 text-neutral-700">{line.description}</p>
            <ul class="mt-7 flex flex-wrap gap-2" aria-label={`Temas relacionados con ${line.title}`}>
              {line.topics.map((topic) => <li class="border border-stone-300 bg-white px-3 py-2 text-xs font-medium text-neutral-600">{topic}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </MotionSection>

    <MotionSection id="investigacion" class="border-y border-stone-200 bg-stone-100" labelledBy="investigacion-title">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <SectionHeading
          id="investigacion-title"
          eyebrow="Investigación"
          title="Cómo aprendemos, razonamos y utilizamos IA en formación clínica"
          lead="Investigo cómo las personas aprenden, razonan y utilizan inteligencia artificial en contextos de formación clínica, y cómo estas tecnologías pueden incorporarse de forma responsable a educación en salud y rehabilitación."
        />
        <a
          href="https://orcid.org/0009-0007-0325-3344"
          target="_blank"
          rel="me noopener noreferrer"
          data-event="orcid_click"
          data-event-label="research_header"
          class="quiet-link inline-flex min-h-12 items-center font-semibold text-gold-800 underline"
        >
          ORCID 0009-0007-0325-3344<span class="sr-only"> (abre en una pestaña nueva)</span>
        </a>
      </div>

      <div id="publicaciones" class="mt-16" aria-labelledby="publicadas-title">
        <div class="editorial-rule h-px w-full"></div>
        <h3 id="publicadas-title" class="mt-6 text-sm font-bold uppercase tracking-[0.18em] text-neutral-700">Publicado</h3>

        <div class="mt-7 space-y-8">
          {publications.map((publication) => (
            <article class="interactive-card border border-stone-300 bg-white p-6 md:p-9 lg:p-11">
              <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(17rem,0.8fr)] lg:gap-12">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[0.16em] text-gold-800">
                    <span>Publicación {publication.number}</span><span aria-hidden="true">·</span><span>{publication.year}</span>
                  </div>
                  <h4 class="text-balance mt-5 font-serif text-2xl font-semibold leading-snug text-neutral-950 md:text-3xl">{publication.title}</h4>
                  <p class="mt-5 text-sm font-semibold leading-6 text-neutral-800">{publication.authors}</p>
                  <p class="mt-2 text-sm leading-6 text-neutral-600">{publication.journal}</p>
                  <p class="mt-1 font-mono text-xs text-neutral-600">DOI {publication.doi}</p>
                  <p class="mt-6 border-l-2 border-gold-500 pl-4 text-sm font-medium leading-7 text-neutral-700">{publication.design}</p>

                  <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                    <AnimatedButton
                      href={publication.articleUrl}
                      external
                      variant="primary"
                      event="research_publication_click"
                      eventLabel={`${publication.doi}:article`}
                    >
                      Leer publicación
                    </AnimatedButton>
                    <AnimatedButton
                      href={publication.doiUrl}
                      external
                      variant="secondary"
                      event="research_publication_click"
                      eventLabel={`${publication.doi}:doi`}
                    >
                      Ver DOI
                    </AnimatedButton>
                  </div>
                </div>

                <div class="border-t border-stone-200 pt-7 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
                  <p class="text-xs font-bold uppercase tracking-[0.16em] text-neutral-500">Hallazgo</p>
                  <p class="mt-3 text-sm leading-7 text-neutral-800">{publication.finding}</p>
                  <dl class="mt-6 grid gap-3">
                    {publication.metrics.map(([label, value]) => (

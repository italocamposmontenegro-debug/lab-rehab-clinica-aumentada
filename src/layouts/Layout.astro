---
interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Ítalo Campos | Neurorehabilitación, educación en salud e inteligencia artificial',
  description = 'Kinesiólogo, académico e investigador. Trabajo en sistemas aumentativos para el aprendizaje clínico y la rehabilitación, investigación aplicada y adopción responsable de inteligencia artificial.',
  structuredData,
} = Astro.props;

const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();
const socialImageURL = new URL('/italo-profile.jpg', siteURL).toString();
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es-CL" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ítalo Campos Montenegro" />
    <meta
      name="keywords"
      content="Ítalo Campos, Italo Campos Montenegro, Kinesiología, inteligencia artificial, rehabilitación, neurorehabilitación, educación en salud, formación clínica, tutor virtual"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#171717" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Retrato profesional de Ítalo Campos Montenegro" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Ítalo Campos" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Retrato profesional de Ítalo Campos Montenegro" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <title>{title}</title>

    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-stone-50 font-sans text-neutral-800 antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  :root {
    color-scheme: light;
    font-synthesis: none;
  }

  html {
    background: #fafaf9;
    overflow-x: hidden;
    scroll-padding-top: 5.5rem;
  }

  body {
    min-width: 320px;
    overflow-x: hidden;
  }

  ::selection {
    background: rgba(197, 163, 68, 0.28);
    color: #171717;
  }

  a,
  button,
  summary {
    -webkit-tap-highlight-color: transparent;
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid #9a7430;
    outline-offset: 4px;
  }

  section[id] {
    scroll-margin-top: 5.5rem;
  }

  .text-balance {
    text-wrap: balance;
  }

  .text-pretty {
    text-wrap: pretty;
  }

  .section-shell {
    margin-inline: auto;
    max-width: 72rem;
    padding-inline: 1.5rem;
  }

  .editorial-rule {
    background: linear-gradient(90deg, #b8923a 0 2.75rem, #d6d3d1 2.75rem 100%);
  }

  .quiet-link {
    text-decoration-color: rgba(154, 116, 48, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .quiet-link:hover {
    color: #7a5729;
    text-decoration-color: currentColor;
  }

  .interactive-card {
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .interactive-card:hover,
  .interactive-card:focus-within {
    border-color: rgba(154, 116, 48, 0.55);
    box-shadow: 0 18px 44px rgba(23, 23, 23, 0.07);
    transform: translateY(-2px);
  }

  #navbar.is-scrolled {
    background: rgba(250, 250, 249, 0.96);
    border-color: #d6d3d1;
    box-shadow: 0 10px 30px rgba(23, 23, 23, 0.05);
  }

  @media (min-width: 768px) {
    .section-shell {
      padding-inline: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }
</style>

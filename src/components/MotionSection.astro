---
interface Props {
  id?: string;
  class?: string;
  innerClass?: string;
  labelledBy?: string;
}

const {
  id,
  class: className = '',
  innerClass = 'section-shell',
  labelledBy,
} = Astro.props;
---

<section id={id} aria-labelledby={labelledBy} class:list={['py-20 md:py-28', className]}>
  <div class:list={[innerClass]}>
    <slot />
  </div>
</section>

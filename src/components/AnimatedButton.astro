---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'gold' | 'ghost';
  external?: boolean;
  event?: string;
  eventLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  external = false,
  event,
  eventLabel,
  class: className = '',
} = Astro.props;

const styles = {
  primary: 'border-neutral-950 bg-neutral-950 text-white hover:border-gold-700 hover:bg-gold-700',
  secondary: 'border-neutral-300 bg-transparent text-neutral-900 hover:border-gold-600 hover:text-gold-800',
  gold: 'border-gold-400 bg-gold-400 text-neutral-950 hover:border-gold-300 hover:bg-gold-300',
  ghost: 'border-transparent bg-transparent px-0 text-gold-800 hover:text-gold-950',
};
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-event={event}
  data-event-label={eventLabel}
  class:list={[
    'group inline-flex min-h-12 items-center justify-center gap-2 border px-5 py-3 text-sm font-semibold transition-colors duration-200 focus:outline-none',
    styles[variant],
    className,
  ]}
>
  <slot />
  {external && <span class="sr-only"> (abre en una pestaña nueva)</span>}
</a>

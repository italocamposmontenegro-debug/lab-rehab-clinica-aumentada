---
const variants=[
 {id:'base',label:'Base',title:'ComunicApp · el punto de partida',description:'Mensajes iniciales para expresar necesidades, solicitar apoyo, comunicar preferencias y participar. Desde esta estructura común parten las distintas adaptaciones.',link:'/formacion/ra01/demo/base',cta:'Probar el punto de partida'},
 {id:'apoyo-cognitivo',label:'Apoyo cognitivo',title:'Una actividad con ayudas graduadas',description:'La arquitectura común guía cinco pasos y cambia la cantidad de ayuda visual, textual y verbal.',link:'/formacion/ra01/demo/apoyo-cognitivo',cta:'Probar ayudas graduadas'},
 {id:'acceso-motor',label:'Acceso motor',title:'Los mismos mensajes, otra geometría',description:'El profesional selecciona una zona de alcance y los botones se reorganizan espacialmente.',link:'/formacion/ra01/demo/acceso-motor',cta:'Probar distribución por alcance'},
];
---
<figure class="ra-hero-figure ra-explorer" data-ra-explorer>
 <div class="ra-window-top"><span>Una base · distintas posibilidades</span><span>RA01 / CAA</span></div>
 <div class="ra-variant-tabs" data-variant-tabs role="group" aria-label="Explorar personalizaciones">{variants.map((v,i)=><button type="button" disabled data-variant-choice={v.id} data-title={v.title} data-description={v.description} data-link={v.link} data-cta={v.cta} aria-pressed={i===0} aria-controls="ra-product-preview">{v.label}</button>)}</div>
 <div id="ra-product-preview" class="ra-product-preview" aria-label="Vista del software seleccionado">
  <div class="ra-preview-heading"><span data-variant-title>{variants[0].title}</span><span class="ra-small">Detalle real</span></div>
  <img data-variant-image src="/ra01/demos/hero-base.webp" srcset="/ra01/demos/hero-base-sm.webp 640w, /ra01/demos/hero-base.webp 1088w" sizes="(min-width: 1200px) 490px, (min-width: 901px) 42vw, (min-width: 641px) 600px, calc(100vw - 80px)" width="1088" height="710" fetchpriority="high" alt="Detalle real de las dos primeras filas del tablero base: mensajes iniciales para expresar necesidades y solicitar apoyo."/>
  <iframe data-variant-frame hidden title="Demostración funcional RA01" loading="lazy"></iframe>
 </div>
 <div class="ra-annotations" aria-label="Funciones conservadas"><span>Mensajes personalizados</span><span>Categorías adaptables</span><span>Lectura en voz alta</span></div>
 <figcaption><p data-variant-description class="ra-small" aria-live="polite">{variants[0].description}</p><a class="quiet-link" data-variant-link href={variants[0].link}>{variants[0].cta} →</a><p class="ra-small ra-demo-disclosure">Vista parcial · Situaciones ficticias · Prototipos educativos</p></figcaption>
</figure>

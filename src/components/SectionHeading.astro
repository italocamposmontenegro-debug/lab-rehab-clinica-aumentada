---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  inverse?: boolean;
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  lead,
  align = 'left',
  inverse = false,
  id,
  class: className = '',
} = Astro.props;
---

<div class:list={['section-heading', align === 'center' ? 'mx-auto text-center' : '', className]}>
  {eyebrow && (
    <p class:list={[
      'mb-4 text-xs font-bold uppercase tracking-[0.19em]',
      inverse ? 'text-gold-300' : 'text-gold-800',
    ]}>
      {eyebrow}
    </p>
  )}
  <h2 id={id} class:list={[
    'text-balance max-w-4xl font-serif text-3xl font-semibold leading-[1.12] md:text-5xl',
    align === 'center' ? 'mx-auto' : '',
    inverse ? 'text-white' : 'text-neutral-950',
  ]}>
    {title}
  </h2>
  {lead && (
    <p class:list={[
      'text-pretty mt-6 max-w-3xl text-base leading-8 md:text-lg',
      align === 'center' ? 'mx-auto' : '',
      inverse ? 'text-neutral-300' : 'text-neutral-600',
    ]}>
      {lead}
    </p>
  )}
</div>

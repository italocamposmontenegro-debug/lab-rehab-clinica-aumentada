---
import { ra01, policyPath } from '../config/ra01.config';
import CTA from './RA01CTA.astro';
import Price from './RA01Price.astro';
---
<div class="ra-enrollment">
  <h3>RA01</h3>
  <p class="ra-small">31 octubre · 09:00–13:30 · online en vivo</p>
  <Price/>
  <div class="ra-actions"><CTA/></div>
  <p class="ra-small" style="margin-top:18px"><a class="quiet-link" href={`${ra01.canonicalPath}/pago/?method=transfer`} data-ra-event="ra01_transfer_select" data-method="transfer">Prefiero transferencia</a></p>
  <div class="ra-inline-links"><a href={policyPath('terminos')}>Condiciones de inscripción</a><a href={policyPath('privacidad')}>Aviso de privacidad</a></div>
</div>

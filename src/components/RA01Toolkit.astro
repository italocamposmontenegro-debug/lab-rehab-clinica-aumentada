// Literal, short excerpts from the supplied originals and the existing private preparation guide.
const pieces=[
 ['Software base','index.html','No partes desde cero.',`function copyInitialCards() {\n  return initialCards.map((card) => ({ ...card }));\n}`,'Una copia de las tarjetas iniciales permite recuperar el punto de partida.'],
 ['Prompts','PROMPTS.txt','Ordenan cada etapa de modificación.',`Lee AGENTS.md y revisa index.html. Realiza únicamente estos ajustes:\n\n1. [EDITAR]\n2. [EDITAR]\n3. [EDITAR]`,'Fragmento del prompt 3: realizar ajustes pequeños.'],
 ['Reglas IA','AGENTS.md','Protegen funciones esenciales durante la personalización.',`## Elementos protegidos\n\nCodex debe conservar:\n\n- funcionamiento sin servidor;\n- un único archivo \u0060index.html\u0060 para toda la aplicación;\n- lectura en voz alta;\n- categorías;\n- filtros;`,'Inicio de la lista de funciones protegidas; el archivo contiene la lista completa.'],
 ['Checklist','CHECKLIST.txt','Permite probar antes de cerrar el proyecto.',`[ ] Todos los controles reciben foco.\n[ ] Siempre puedo identificar dónde está el foco.\n[ ] El orden del foco es comprensible.\n[ ] No quedo atrapado en ningún control.\n[ ] Puedo usar toda la aplicación sin mouse.`,'Fragmento de la revisión de accesibilidad con teclado.'],
 ['Guía','GUIA_PREPARACION_RA01.md','Prepara el entorno antes del encuentro.',`Conserva \u0060originales\u0060 sin cambios. Copia el HTML en una carpeta \u0060mi-proyecto\u0060 y guarda una copia antes de cada modificación.`,'Fragmento del paso 2 de la guía de preparación.'],
];
---
<section id="kit" class="ra-section"><div class="section-shell"><div class="ra-split"><div><p class="ra-eyebrow">Kit de Construcción RA01</p><h2>Abre el Kit.<br/>Entiende cómo avanzar.</h2></div><div><p class="ra-lead">Software, instrucciones y pruebas conectados entre sí. Recibirás el Kit completo después de confirmar tu inscripción y pago.</p><p class="ra-small">Materiales online hasta el 31 de enero de 2027. Puedes conservar las copias descargadas conforme a sus condiciones de uso.</p></div></div>
<div class="ra-toolkit" data-ra-toolkit><div class="ra-toolkit-menu" role="group" aria-label="Explorar piezas del Kit">{pieces.map(([name,file,purpose],i)=><button data-kit-piece={i} aria-pressed={i===0} aria-controls={`ra-kit-${i}`}><span class="ra-tool-index">0{i+1}</span><span><strong>{name}</strong><span>{purpose}</span><small>{file}</small></span></button>)}</div><div class="ra-toolkit-content">{pieces.map(([name,file,,excerpt,caption],i)=><article id={`ra-kit-${i}`} data-kit-panel={i}><div class="ra-file-bar"><span>{file}</span><span>Extracto real</span></div><h3>{name}</h3>{i===0?<><p class="ra-small" style="margin-bottom:18px">La arquitectura ya funciona. Tú modificarás contenido, organización y presentación sin tener que construirla desde cero.</p><img src="/ra01/demos/hero-base-sm.webp" width="640" height="418" loading="lazy" alt="Detalle real de ComunicApp: categorías y mensajes iniciales del tablero base." style="display:block;max-width:100%;height:auto;border:1px solid #d6d3d1;background:#fff"/><details style="margin-top:18px"><summary style="display:flex;align-items:center;min-height:44px;cursor:pointer;color:#674928;font-size:13px">Ver detalle técnico</summary><pre><code>{excerpt}</code></pre><p class="ra-small">{caption}</p></details></>:<><pre><code>{excerpt}</code></pre><p class="ra-small">{caption}</p></>}<p class="ra-small ra-toolkit-foot">Parte del Kit · No es el archivo completo</p></article>)}</div></div></div></section>

---
interface Props {
  study: string;
  title: string;
  purpose: string;
  design: string;
  findings: string[];
  contribution: string;
}

const { study, title, purpose, design, findings, contribution } = Astro.props;
---

<article class="research-card motion-child group border border-neutral-200 bg-white p-7 transition duration-300 ease-out focus-within:border-gold-400 md:p-8">
  <span class="text-xs font-bold uppercase tracking-[0.2em] text-gold-700">{study}</span>
  <h3 class="mt-4 font-serif text-xl font-semibold leading-snug text-neutral-950">{title}</h3>

  <div class="mt-6 space-y-5">
    <div>
      <p class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-neutral-500">Propósito</p>
      <p class="text-sm leading-relaxed text-neutral-600">{purpose}</p>
    </div>
    <div>
      <p class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-neutral-500">Diseño</p>
      <p class="text-sm leading-relaxed text-neutral-600">{design}</p>
    </div>
    <div>
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-neutral-500">Hallazgos clave</p>
      <ul class="space-y-2 text-sm leading-relaxed text-neutral-600">
        {findings.map((finding) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-gold-500"></span>
            <span>{finding}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="border-t border-neutral-200 pt-5">
      <p class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-neutral-500">Contribución</p>
      <p class="text-sm leading-relaxed text-neutral-700">{contribution}</p>
    </div>
  </div>
</article>
